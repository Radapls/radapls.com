---
import type { ImageMetadata } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { Image } from 'astro:assets';
import { DEFAULT_LOCALE, type Lang } from 'src/i18n';

interface Props {
	image: {
		src?: ImageMetadata;
		svg?: AstroComponentFactory;
		tone?: string;
		height: number;
		width: number;
		alt: string;
	};
	title: string;
	organization: string;
	relativeTime: string;
	summary?: string;
	link?: string;
}

const currentLocale = (Astro.currentLocale as Lang | undefined) ?? DEFAULT_LOCALE;

const { image, title, organization, relativeTime, summary, link } = Astro.props;
const LogoSvg = image.svg;
const toneClass = image.tone ? ` brand-icon--${image.tone}` : '';
const svgClass = `brand-icon brand-icon--svg${toneClass}`;
const imgClass = `brand-icon${toneClass}`;
---

<div class="qualification__data">
	<div class="qualification__marker">
		<span class="qualification__rounder"></span>
		<span class="qualification__line"></span>
	</div>
	<div class="qualification__card">
		{
			LogoSvg ? (
				<LogoSvg
					class={svgClass}
					role="img"
					aria-label={image.alt}
					height={image.height}
					width={image.width}
				/>
			) : (
				<Image
					src={image.src!}
					draggable="false"
					alt={image.alt}
					class={imgClass}
					height={image.height}
					width={image.width}
				/>
			)
		}
		<h3 class="qualification__title">{title}</h3>
		{
			link ? (
				<a href={link}>
					<span class="qualification__subtitle">{organization}</span>
				</a>
			) : (
				<span class="qualification__subtitle">{organization}</span>
			)
		}
		<div class="qualification__calendar">
			<i class="uil uil-calendar-alt" aria-hidden="true"></i>
			{relativeTime}
		</div>
	</div>
</div>

<style>
	a {
		color: var(--first-color-second);
	}
	/* Uniform square footprint for every logo regardless of its own aspect
	   ratio; the logo scales to fit inside the box and stays centered. */
	.brand-icon {
		width: 42px;
		height: 42px;
		object-fit: contain;
		filter: drop-shadow(0 0 0.5px gray);
	}
	/* Inline SVG brand logos: inherit a theme-aware color via currentColor
	   so dark logos (e.g. Ericsson) stay visible in dark mode. */
	.brand-icon--svg {
		color: var(--title-color);
		display: inline-block;
		object-fit: contain;
	}
	/* Birdi's shield uses currentColor: navy in light, light tint in dark
	   (the inner "b" stays white in the SVG) — no wrapping container. */
	.brand-icon--birdi {
		color: #243746;
	}
	:global(.dark) .brand-icon--birdi {
		color: var(--marker-color-birdi);
	}
	/* IEI is multi-color; render it as a solid white silhouette in dark mode. */
	:global(.dark) .brand-icon--iei {
		filter: brightness(0) invert(1);
	}
</style>

---
import { Image } from 'astro:assets';

interface Props {
	link: string;
	bgImage: any;
	title: string;
	description: string;
	/** internal links open in the same tab */
	external?: boolean;
	variant?: 'feature' | 'side' | 'wide';
}

const { link, bgImage, title, description, external = true, variant = 'side' } = Astro.props;
---

<a
	class:list={['card', `card--${variant}`]}
	href=`${link}`
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
>
	<span class="card__thumb">
		<Image class="card__image" src={bgImage} alt="" loading="lazy" width={320} />
	</span>
	<div class="card__content">
		<h3 class="card__title" id={`title-${title}`}>
			{title}
		</h3>
		<p class="card__description">
			{description}
		</p>
	</div>
	<span class="card__arrow" aria-hidden="true">
		↗&#xFE0E;
	</span>
</a>

<style>
	.card {
		position: relative;
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 1.4vw, 1.25rem);
		width: 100%;
		min-width: 0;
		padding: clamp(0.85rem, 1.6vw, 1.5rem);
		border: 1px solid color-mix(in srgb, var(--title-color) 12%, transparent);
		border-radius: var(--radius-lg);
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--container-color) 94%, var(--first-color)),
			var(--container-color) 58%
		);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition:
			box-shadow 200ms ease-in-out,
			transform 200ms ease-in-out;
	}
	.card:hover,
	.card:focus-visible {
		box-shadow: var(--shadow-md);
		transform: translateY(-3px);
	}
	.card--feature {
		grid-column: span 7;
		grid-row: span 2;
		flex-direction: column;
		align-items: stretch;
		justify-content: space-between;
	}
	.card--side {
		grid-column: span 5;
	}
	.card--wide {
		grid-column: 1 / -1;
	}
	.card__thumb {
		flex: 0 0 auto;
		width: clamp(4.5rem, 8vw, 6rem);
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: var(--radius-md);
		background-color: color-mix(in srgb, var(--body-color) 75%, transparent);
	}
	.card__image {
		width: 100%;
		height: 100%;
		padding: 0.75rem;
		object-fit: contain;
	}
	.card--feature .card__thumb {
		width: 100%;
		min-height: 0;
		flex: 1 1 auto;
		aspect-ratio: auto;
	}
	.card--feature .card__image {
		max-height: 100%;
		padding: clamp(1rem, 3vw, 2.5rem);
	}
	.card--wide .card__thumb {
		width: 5rem;
	}
	.card__content {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-right: 2.75rem;
	}
	.card__title {
		font-size: var(--h3-font-size);
		font-weight: var(--font-semi-bold);
		text-wrap: balance;
	}
	.card__description {
		color: var(--text-color);
		font-size: var(--smaller-font-size);
		line-height: 1.5;
	}
	.card__arrow {
	font-family: var(--title-font);
	font-weight: 200;
	font-size: 1.25rem;
	line-height: 1;
	color: var(--container-color);
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem;
		border-radius: 50%;
		background-color: var(--first-color);
		transition: 300ms ease-in-out;
	}
	.card:hover .card__arrow,
	.card:focus-visible .card__arrow {
		background-color: var(--first-color-alt);
		rotate: 45deg;
	}
	@media screen and (max-width: 900px) {
		.card--feature,
		.card--wide {
			grid-column: 1 / -1;
			grid-row: auto;
		}
		.card--side {
			grid-column: span 1;
		}
		.card--feature {
			min-height: 0;
		}
	}
	@media screen and (max-width: 560px) {
		.card--feature,
		.card--side,
		.card--wide {
			grid-column: span 1;
			grid-row: auto;
			min-height: 0;
			flex-direction: column;
			align-items: stretch;
			justify-content: center;
		}
		.card__thumb {
			position: absolute;
			top: 0.65rem;
			left: 0.65rem;
			width: 2.5rem;
			aspect-ratio: 1;
		}
		.card--feature .card__thumb {
			width: 2.5rem;
			min-height: 0;
			flex: 0 0 auto;
			aspect-ratio: 1;
		}
		.card__content {
			flex: 1 1 auto;
			justify-content: center;
			gap: 0.2rem;
			padding: 3rem 0 0;
		}
		.card__title {
			font-size: clamp(0.8rem, 2.2vw, var(--small-font-size));
		}
		.card__description {
			font-size: clamp(0.72rem, 1.8vw, var(--smaller-font-size));
			line-height: 1.35;
		}
	}
	@media screen and (min-width: 561px) and (max-height: 640px) {
		.card--feature,
		.card--side,
		.card--wide {
			grid-column: span 1;
			grid-row: auto;
			min-height: 0;
			flex-direction: row;
			align-items: center;
		}
		.card__thumb,
		.card--feature .card__thumb {
			width: 3rem;
			min-height: 0;
			flex: 0 0 auto;
			aspect-ratio: 1;
		}
		.card__content {
			gap: 0.2rem;
			padding-right: 1.5rem;
		}
		.card__title {
			font-size: clamp(0.8rem, 2.2vw, var(--small-font-size));
		}
		.card__description {
			font-size: clamp(0.72rem, 1.8vw, var(--smaller-font-size));
			line-height: 1.35;
		}
	}
	@media screen and (max-width: 768px) {
		.card__arrow {
			padding: 0.5rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card,
		.card__arrow {
			transition: none;
		}
	}
</style>

---
// Wibx brand header with selectable project and feature groups.
export interface MapProject {
	title: string;
	url?: string;
	image?: ImageMetadata;
	description?: string;
}

export interface MapArea {
	id: string;
	title: string;
	panelTitle?: string;
	panelIntro?: string;
	panelOutro?: string;
	/** Small line under the label, e.g. the repo name */
	sub?: string;
	url?: string;
	image?: ImageMetadata;
	/** Position in the viewBox */
	x: number;
	y: number;
	r?: number;
	projects: MapProject[];
}

interface Props {
	/** Center node the areas connect to */
	center: { title: string; url?: string; image?: ImageMetadata; x: number; y: number; r?: number };
	areas: MapArea[];
	viewBox?: string;
}

const { center, areas, viewBox = '0 0 960 520' } = Astro.props;
const cr = center.r ?? 56;
---

<div class="pmap">
	<svg class="pmap__svg" viewBox={viewBox} role="group" aria-label={center.title}>
		{
			areas.map((a) => (
				<g class="pmap__link" aria-hidden="true">
					<line x1={center.x} y1={center.y} x2={a.x} y2={a.y} />
					<circle cx={(center.x + a.x) / 2} cy={(center.y + a.y) / 2} r="4" />
				</g>
			))
		}
		<a
			class="pmap__node pmap__node--link"
			href={center.url}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={center.title}
		>
			<circle cx={center.x} cy={center.y} r={cr + 4} class="pmap__halo" />
			<clipPath id="pmap-clip-center">
				<circle cx={center.x} cy={center.y} r={cr} />
			</clipPath>
			{center.image && (
				<image
					href={center.image.src}
					x={center.x - cr * 0.9}
					y={center.y - cr * 0.9}
					width={cr * 1.8}
					height={cr * 1.8}
					clip-path="url(#pmap-clip-center)"
					preserveAspectRatio="xMidYMid meet"
				/>
			)}
			<text x={center.x} y={center.y + cr + 22} class="pmap__label">{center.title}</text>
		</a>
		{
			areas.map((a, i) => {
				const r = a.r ?? 44;
				return (
					<g
						class="pmap__area"
						data-area={a.id}
						role="button"
						tabindex="0"
						aria-pressed={i === 0 ? 'true' : 'false'}
					>
						<circle cx={a.x} cy={a.y} r={r + 4} class="pmap__halo" />
						<clipPath id={`pmap-clip-${a.id}`}>
							<circle cx={a.x} cy={a.y} r={r} />
						</clipPath>
						{a.image ? (
							<image
								href={a.image.src}
								x={a.x - r * 0.9}
								y={a.y - r * 0.9}
								width={r * 1.8}
								height={r * 1.8}
								clip-path={`url(#pmap-clip-${a.id})`}
								preserveAspectRatio="xMidYMid meet"
							/>
						) : (
							<g clip-path={`url(#pmap-clip-${a.id})`}>
								<circle cx={a.x} cy={a.y} r={r} class="pmap__placeholder" />
								<text x={a.x} y={a.y + r * 0.35} class="pmap__initial">
									{a.title.charAt(0)}
								</text>
							</g>
						)}
						<text x={a.x} y={a.y + r + (a.sub ? 16 : 22)} class="pmap__label">
							{a.title}
						</text>
						{a.sub && (
							<text x={a.x} y={a.y + r + 34} class="pmap__sub">
								{a.sub}
							</text>
						)}
					</g>
				);
			})
		}
	</svg>

	<nav class="pmap__mobile-areas" aria-label="Project categories">
		{areas.map((a, i) => (
			<button
				class="pmap__area-button"
				data-area={a.id}
				aria-pressed={i === 0 ? 'true' : 'false'}
				type="button"
			>
				<span>{a.title}</span>
				{a.sub && <small>{a.sub}</small>}
			</button>
		))}
	</nav>

	{
		areas.map((a, i) => (
			<div class:list={['pmap__panel', { 'is-active': i === 0 }]} data-area={a.id}>
				{a.panelTitle && <h3 class="pmap__panel-title">{a.panelTitle}</h3>}
				{a.panelIntro && <p class="pmap__panel-intro">{a.panelIntro}</p>}
				<ul class="pmap__projects" aria-label={a.title}>
					{a.projects.map((p) => {
						const item = (
							<span class="pmap__project">
								{p.image ? (
									<img src={p.image.src} alt={p.title} width="96" height="96" loading="lazy" />
								) : (
									<span class="pmap__project-initial" aria-hidden="true">
										{p.title.charAt(0)}
									</span>
								)}
								<span class="pmap__project-name">{p.title}</span>
							</span>
						);
						return (
							<li>
								{p.description ? (
									<button
										class="pmap__feature-button"
										type="button"
										data-title={p.title}
										data-description={p.description}
										aria-pressed="false"
									>
										{item}
									</button>
								) : p.url ? (
									<a href={p.url} target="_blank" rel="noopener noreferrer">
										{item}
									</a>
								) : item}
							</li>
						);
					})}
				</ul>
				{a.panelOutro && <p class="pmap__panel-outro">{a.panelOutro}</p>}
				{a.projects.some((p) => p.description) && (
					<div class="pmap__feature-description" aria-live="polite" hidden>
						<strong></strong>
						<p></p>
					</div>
				)}
			</div>
		))
	}
</div>

<script>
	// Clicking (or keyboard-activating) an area node swaps the panel below.
	const activate = (btn: Element) => {
		const map = btn.closest('.pmap');
		if (!map) return;
		const id = (btn as HTMLElement).dataset.area;
		map.querySelectorAll('.pmap__area, .pmap__area-button').forEach((b) => {
			b.setAttribute('aria-pressed', String(b === btn));
		});
		map.querySelectorAll('.pmap__panel').forEach((p) => {
			p.classList.toggle('is-active', (p as HTMLElement).dataset.area === id);
			const description = p.querySelector('.pmap__feature-description') as HTMLElement | null;
			if (description) description.hidden = true;
			p.querySelectorAll('.pmap__feature-button').forEach((feature) => feature.setAttribute('aria-pressed', 'false'));
		});
	};
	const onClick = (e: Event) => {
		const target = e.target as HTMLElement;
		const feature = target.closest('.pmap__feature-button') as HTMLButtonElement | null;
		if (feature) {
			const panel = feature.closest('.pmap__panel');
			const description = panel?.querySelector('.pmap__feature-description') as HTMLElement | null;
			if (!panel || !description) return;
			panel.querySelectorAll('.pmap__feature-button').forEach((button) => {
				button.setAttribute('aria-pressed', String(button === feature));
			});
			const title = description.querySelector('strong');
			const text = description.querySelector('p');
			if (title) title.textContent = feature.dataset.title ?? '';
			if (text) text.textContent = feature.dataset.description ?? '';
			description.hidden = false;
			return;
		}
		const btn = target.closest('.pmap__area, .pmap__area-button');
		if (btn) activate(btn);
	};
	const onKey = (e: KeyboardEvent) => {
		if (e.key !== 'Enter' && e.key !== ' ') return;
		const btn = (e.target as HTMLElement).closest('.pmap__area, .pmap__area-button');
		if (btn) {
			e.preventDefault();
			activate(btn);
		}
	};
	document.addEventListener('click', onClick);
	document.addEventListener('keydown', onKey);
</script>

<style>
	.pmap__svg {
		display: none;
	}
	.pmap__mobile-areas {
		display: flex;
		justify-content: center;
		gap: clamp(1rem, 5vw, 3rem);
		margin-block: 0.5rem var(--mb-1-5);
		border-bottom: 1px solid color-mix(in srgb, var(--text-color) 14%, transparent);
	}
	.pmap__area-button {
		min-width: 8.5rem;
		min-height: 3rem;
		padding: 0.55rem 0.8rem;
		border: 0;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;
		background: transparent;
		color: var(--text-color-light);
		font: inherit;
		cursor: pointer;
	}
	.pmap__area-button:hover,
	.pmap__area-button:focus-visible { color: var(--title-color); }
	.pmap__area-button:focus-visible { outline: 2px solid var(--first-color); outline-offset: 2px; }
	.pmap__area-button[aria-pressed='true'] {
		border-bottom-color: var(--first-color);
		color: var(--title-color);
		font-weight: 600;
	}
	.pmap__link line {
		stroke: color-mix(in srgb, var(--first-color) 35%, transparent);
		stroke-width: 1.5;
		stroke-dasharray: 4 6;
	}
	.pmap__link circle {
		fill: color-mix(in srgb, var(--first-color) 55%, transparent);
	}
	.pmap__node--link {
		cursor: pointer;
		&:hover .pmap__halo,
		&:focus-visible .pmap__halo {
			stroke: var(--first-color);
		}
	}
	.pmap__area {
		cursor: pointer;
		&:hover .pmap__halo,
		&:focus-visible .pmap__halo {
			stroke: var(--first-color);
		}
		&:focus-visible {
			outline: none;
		}
	}
	.pmap__area[aria-pressed='true'] .pmap__halo {
		stroke: var(--first-color);
		stroke-width: 3;
	}
	.pmap__halo {
		fill: transparent;
		stroke: color-mix(in srgb, var(--first-color) 30%, transparent);
		stroke-width: 2;
		transition: stroke 200ms ease;
	}
	.pmap__placeholder {
		fill: color-mix(in srgb, var(--first-color) 12%, var(--container-color));
	}
	.pmap__initial {
		text-anchor: middle;
		font-family: var(--title-font);
		font-size: 30px;
		fill: var(--text-color-light);
	}
	.pmap__label {
		text-anchor: middle;
		font-family: var(--title-font);
		font-size: 15px;
		fill: var(--title-color);
	}
	.pmap__sub {
		text-anchor: middle;
		font-size: 11px;
		font-family: var(--body-font);
		fill: var(--text-color-light);
	}

	.pmap__panel {
		display: none;
	}
	.pmap__panel.is-active {
		display: block;
	}
	.pmap__panel-title {
		margin: 0 0 0.4rem;
		color: var(--title-color);
		font-family: var(--title-font);
		font-size: 1.2rem;
		text-align: center;
	}
	.pmap__panel-intro,
	.pmap__panel-outro {
		max-width: 48rem;
		margin: 0.5rem auto;
		color: var(--text-color-light);
		line-height: 1.55;
		text-align: center;
	}
	.pmap__projects {
		list-style: none;
		padding: 0;
		margin-block: var(--mb-1) 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
		gap: var(--mb-1);
	}
	.pmap__project {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
	}
	.pmap__projects a {
		text-decoration: none;
		display: block;
		transition: transform 200ms ease;
	}
	.pmap__projects a:hover,
	.pmap__projects a:focus-visible {
		transform: scale(1.08);
	}
	.pmap__feature-button {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		cursor: pointer;
	}
	.pmap__feature-button:focus-visible {
		border-radius: 0.5rem;
		outline: 2px solid var(--first-color);
		outline-offset: 3px;
	}
	.pmap__feature-button[aria-pressed='true'] .pmap__project-initial {
		border-color: var(--first-color);
		background: color-mix(in srgb, var(--first-color) 16%, var(--container-color));
	}
	.pmap__feature-description {
		max-width: 42rem;
		margin: 0.75rem auto 0;
		padding: 0.85rem 1rem;
		border: 1px solid color-mix(in srgb, var(--first-color) 20%, transparent);
		border-top: 3px solid var(--first-color);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--first-color) 6%, var(--container-color));
	}
	.pmap__feature-description[hidden] { display: none; }
	.pmap__feature-description strong {
		color: var(--title-color);
		font-family: var(--title-font);
	}
	.pmap__feature-description p {
		margin: 0.25rem 0 0;
		color: var(--text-color-light);
		font-size: var(--small-font-size);
		line-height: 1.45;
	}
	.pmap__projects img,
	.pmap__project-initial {
		width: 5.5rem;
		height: 5.5rem;
		/* Launcher icons are square — treat them like home-screen app icons. */
		border-radius: 22%;
		object-fit: contain;
		padding: 0.4rem;
		background: color-mix(in srgb, var(--first-color) 8%, var(--container-color));
		border: 1px solid color-mix(in srgb, var(--first-color) 18%, transparent);
	}
	.pmap__project-initial {
		display: grid;
		place-content: center;
		font-family: var(--title-font);
		font-size: 1.75rem;
		color: var(--text-color-light);
	}
	.pmap__project-name {
		font-family: var(--title-font);
		font-size: var(--small-font-size);
		color: var(--title-color);
		text-align: center;
	}
	@media screen and (max-width: 567px) {
		.pmap__mobile-areas {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.1rem;
		}
		.pmap__area-button { min-width: 0; padding-inline: 0.25rem; font-size: 0.9rem; }
		.pmap__projects {
		grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.75rem 0.5rem;
		}
		.pmap__projects img,
		.pmap__project-initial {
			width: min(100%, 4.25rem);
			height: auto;
			aspect-ratio: 1;
		}
		.pmap__project-name {
			overflow-wrap: anywhere;
		}
	}
</style>

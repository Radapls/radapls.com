---
/**
 * Race bibs — real objects from my room pinned to the About wall.
 * One bib per race I've run; labels are shortened to fit the card.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const bibs = [
	{ number: '7476', race: 'Medellín 21K' },
	{ number: '2473', race: 'Valle 21K' },
	{ number: '8892', race: 'Cali' },
	{ number: '6163', race: 'Cali 15K' },
	{ number: '46697', race: 'Bogotá 10K' },
	{ number: '3572', race: 'Pacífico 10K' },
	{ number: '0636', race: 'Marriott 10K' },
	{ number: '1043', race: 'La Caña 10K' },
];
---

<ul class:list={['bibs', className]} aria-label="Race numbers">
	{
		bibs.map((bib, i) => (
			<li class="bibs__item" style={`--bib-tilt: ${i % 2 === 0 ? 1.5 : -2}deg;`}>
				<span class="bibs__pin" aria-hidden="true" />
				<span class="bibs__card">
					<span class="bibs__race">{bib.race}</span>
					<span class="bibs__number">{bib.number}</span>
				</span>
			</li>
		))
	}
</ul>

<style>
	.bibs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		gap: 0.4rem;
		list-style: none;
	}

	.bibs__item {
		position: relative;
		display: flex;
		min-width: 0;
		justify-content: center;
		padding-top: 0.35rem; /* room for the pin */
		transform: rotate(var(--bib-tilt, 0deg));
		transition: transform 250ms ease-in-out;
	}
	.bibs__item:hover {
		transform: rotate(0deg) scale(1.04);
	}

	/* the pin holding the bib on the wall */
	.bibs__pin {
		position: absolute;
		top: 0;
		left: 50%;
		width: 5px;
		height: 5px;
		transform: translateX(-50%);
		border-radius: 50%;
		background: var(--title-color);
		box-shadow: 0 1px 1px rgb(0 0 0 / 0.25);
		z-index: 1;
	}

	.bibs__card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		width: 100%;
		min-width: 0;
		padding: 0.3rem 0.25rem;
		background: var(--container-color);
		border: 1px solid color-mix(in srgb, var(--title-color) 30%, transparent);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-sm);
	}

	.bibs__race {
		max-width: 100%;
		overflow: hidden;
		font-size: 0.42rem;
		letter-spacing: 0.06em;
		text-overflow: ellipsis;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--text-color);
		border-block: 1px solid color-mix(in srgb, var(--title-color) 25%, transparent);
		padding-block: 0.12rem;
	}

	.bibs__number {
		font-family: var(--title-font);
		font-size: 0.9rem;
		font-weight: var(--font-bold);
		line-height: 1.1;
		color: var(--title-color);
	}
</style>

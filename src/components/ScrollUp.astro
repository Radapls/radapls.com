---
import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
---

<button
	class="scrollup"
	id="scroll-up"
	type="button"
	aria-label={t({ en: 'Scroll to top', es: 'Volver arriba', 'pt-br': 'Voltar ao topo' })}
>
	<span class="scrollup__icon" aria-hidden="true">↑</span>
</button>

<script>
	function setupScrollUp() {
		const scrollUp = document.getElementById('scroll-up') as HTMLButtonElement | null;
		if (!scrollUp) return;

		// Attach the click handler once (guard against re-init duplicates).
		if (!scrollUp.dataset.bound) {
			scrollUp.addEventListener('click', () => {
				window.scrollTo({ top: 0 });
			});
			scrollUp.dataset.bound = 'true';
		}

		const onScroll = () => {
			scrollUp.classList.toggle('show-scroll', window.scrollY >= 200);
		};
		// Replace any listener from a previous page to avoid stacking.
		const w = window as any;
		if (w.__scrollUpHandler) window.removeEventListener('scroll', w.__scrollUpHandler);
		w.__scrollUpHandler = onScroll;
		window.addEventListener('scroll', onScroll);
		onScroll();
	}

	document.addEventListener('astro:page-load', setupScrollUp);
</script>

<style>
	.scrollup {
		position: fixed;
		right: 1rem;
		bottom: -20%;
		background-color: var(--first-color);
		border: 0;
		opacity: 0;
		padding: 0.5rem;
		border-radius: var(--radius-pill);
		z-index: var(--z-tooltip);
		transition: 0.4s;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}

	.scrollup:hover {
		background-color: var(--first-color-alt);
	}

	.scrollup__icon {
		font-family: var(--title-font);
	font-weight: 200;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--container-color);
	}

	.show-scroll {
		bottom: 6rem;
		opacity: 1;
	}

	@media screen and (min-width: 768px) {
		.show-scroll {
			bottom: 1rem;
		}
	}
</style>

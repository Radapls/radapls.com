---
/**
 * Font specimen poster — a real poster from my room, part of the About
 * wall. Aged sheet listing typeface names, each word set in its own
 * face (best-effort with system fonts; graceful fallbacks elsewhere).
 * Scheme: line modifiers carry the size, face modifiers carry the
 * font-family.
 */
---

<div class="specimen" role="img" aria-label="Font specimen poster">
	<div class="specimen__list">
		<span class="specimen__line specimen__line--copperlate">
			<svg
				class="specimen__fill specimen__fill--copperlate"
				viewBox="0 0 100 11"
				aria-hidden="true"
			>
				<text
					x="0"
					y="8.6"
					textLength="100"
					lengthAdjust="spacing"
					font-family="Copperplate, Papyrus, fantasy"
					font-size="11">COOPERLATE</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--franklin">
			<span class="specimen__face specimen__face--franklin">Franklin Gothic</span>
		</span>
		<span class="specimen__line specimen__line--avant-garde">
			<svg class="specimen__fill" viewBox="0 0 100 9.5" aria-hidden="true">
				<text
					x="0"
					y="7.4"
					textLength="56"
					lengthAdjust="spacing"
					font-family="'Avant Garde','Century Gothic',sans-serif"
					font-size="8">Avant Garde</text
				>
				<text
					x="59"
					y="7.4"
					textLength="41"
					lengthAdjust="spacing"
					font-family="'Allerta Stencil','Stencil',sans-serif"
					font-size="8">STENCIL</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--globus">
			<svg class="specimen__fill" viewBox="0 0 100 14" aria-hidden="true">
				<text
					x="0"
					y="11"
					textLength="50"
					lengthAdjust="spacing"
					font-family="'Arial Black',Arial,sans-serif"
					font-size="11">GLOBUS</text
				>
				<text
					x="53"
					y="11"
					textLength="47"
					lengthAdjust="spacing"
					font-family="'Bayer Universal','Bauhaus 93',sans-serif"
					font-size="14">Bayer</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--typewriter">
			<svg class="specimen__fill" viewBox="0 0 100 10" aria-hidden="true">
				<text
					x="0"
					y="7.6"
					textLength="56"
					lengthAdjust="spacing"
					font-family="'Courier New',monospace"
					font-weight="700"
					font-size="8">Type Writer</text
				>
				<text
					x="59"
					y="7.6"
					textLength="41"
					lengthAdjust="spacing"
					font-family="'OCR-A BT','Share Tech Mono',monospace"
					font-size="8">Ocr-A</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--american">
			<svg class="specimen__fill specimen__fill--american" viewBox="0 0 100 12" aria-hidden="true">
				<text
					x="0"
					y="9.4"
					textLength="100"
					lengthAdjust="spacing"
					font-family="Georgia, serif"
					font-weight="700"
					font-size="12">American</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--helvetica">
			<svg class="specimen__fill" viewBox="0 0 100 11" aria-hidden="true">
				<text
					x="0"
					y="8.5"
					textLength="52"
					lengthAdjust="spacing"
					font-family="'Helvetica Neue',Helvetica,sans-serif"
					font-weight="700"
					font-size="9.5">Helvectica</text
				>
				<text
					x="55"
					y="8.5"
					textLength="45"
					lengthAdjust="spacing"
					font-family="Centaur,Palatino,Georgia,serif"
					font-size="9.5">Centaur</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--platin">
			<svg class="specimen__fill" viewBox="0 0 100 12" aria-hidden="true">
				<text
					x="0"
					y="9.3"
					textLength="40"
					lengthAdjust="spacing"
					font-family="Rockwell,'Courier New',serif"
					font-weight="bold"
					font-size="10.5">Platin</text
				>
				<text
					x="43"
					y="9.3"
					textLength="57"
					lengthAdjust="spacing"
					font-family="Souvenir,Georgia,serif"
					font-size="10.5">Souvenir</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--broadway">
			<svg class="specimen__fill specimen__fill--broadway" viewBox="0 0 100 13" aria-hidden="true">
				<text
					x="0"
					y="10.1"
					textLength="100"
					lengthAdjust="spacing"
					font-family="Limelight, Broadway, Cooper Black, fantasy"
					font-size="13">Broadway</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--insignia">
			<svg class="specimen__fill" viewBox="0 0 100 12" aria-hidden="true">
				<text
					x="0"
					y="9.3"
					textLength="51"
					lengthAdjust="spacing"
					font-family="'Insignia','Avenir Next',sans-serif"
					font-size="10.5">Insignia</text
				>
				<text
					x="54"
					y="9.3"
					textLength="46"
					lengthAdjust="spacing"
					font-family="'Lucida Bright','Lucida Serif',Georgia,serif"
					font-size="10.5">Lucida</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--gill">
			<svg class="specimen__fill" viewBox="0 0 100 12" aria-hidden="true">
				<text
					x="0"
					y="9.3"
					textLength="51"
					lengthAdjust="spacing"
					font-family="'Gill Sans','Gill Sans MT',sans-serif"
					font-weight="600"
					font-size="10.5">Gill Sans</text
				>
				<text
					x="54"
					y="9.3"
					textLength="46"
					lengthAdjust="spacing"
					font-family="'Bodoni MT',Didot,serif"
					font-size="10.5">Bodoni</text
				>
			</svg>
		</span>
		<span class="specimen__line specimen__line--times">
			<svg class="specimen__fill specimen__fill--times" viewBox="0 0 100 9.5" aria-hidden="true">
				<text
					x="0"
					y="7.4"
					textLength="100"
					lengthAdjust="spacing"
					font-family="Times New Roman, Times, serif"
					font-weight="bold"
					font-size="9.5">Times New Roman</text
				>
			</svg>
		</span>
	</div>
</div>

<style>
	.specimen {
		/* aged cream paper with soft stains and crease lines */
		background:
			linear-gradient(105deg, transparent 46%, rgb(0 0 0 / 0.04) 47%, transparent 49%),
			linear-gradient(75deg, transparent 62%, rgb(0 0 0 / 0.03) 63%, transparent 65%),
			radial-gradient(ellipse at 20% 15%, rgb(120 90 40 / 0.08), transparent 55%),
			radial-gradient(ellipse at 85% 80%, rgb(120 90 40 / 0.1), transparent 50%), #e9dcba;
		/* The paper is the container; the list inside reads its width.
		   (font-size in cqw must live on a descendant — on the container
		   itself the unit falls back to the viewport and explodes.) */
		container-type: inline-size;
		width: clamp(10rem, 18vw, 13rem);
		aspect-ratio: 3 / 4;
		padding: 0.85rem 0.7rem;
		border-radius: 2px;
		box-shadow: var(--shadow-md);
		color: #2b2620;
	}

	.specimen__list {
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
		height: 100%;
		font-size: 5cqw;
		line-height: 1.3;
		text-align: left;
	}

	/* Each line justifies to the full paper width: text-align-last
	   stretches the word spacing of the single line edge to edge,
	   like a real specimen sheet. Single-word lines can't stretch
	   (no spaces) and stay left-aligned. Safety net keeps any line
	   from running past the paper edge. */
	.specimen__line {
		display: block;
		white-space: nowrap;
		max-width: 100%;
		overflow: hidden;
		text-align: justify;
		text-align-last: justify;
	}

	/*---- line modifiers: size only (families live on the faces) ----*/
	/* Tuned in cqw (sheet-width units) so each line's natural width
	   fills the paper — justification then only nudges the word
	   spacing instead of blowing it wide open. */
	.specimen__line--copperlate {
		font-size: 13cqw;
		line-height: 0.8;
	}
	.specimen__line--franklin {
		font-size: 12cqw;
		line-height: 1;
	}

	/*---- face modifiers: one per typeface on the sheet ----*/
	.specimen__face--copperlate {
		font-family: 'Copperplate', 'Papyrus', fantasy;
	}
	.specimen__face--franklin {
		font-family: 'Franklin Gothic Medium', 'Franklin Gothic', sans-serif;
		font-weight: 900;
		/* wider tracking fills the line so justify doesn't blow the one
		   word gap wide open */
		letter-spacing: 0.06em;
	}
	/* Broadway is a commercial MS font; Limelight is the closest free Deco face */

	/*---- fill-text: SVG textLength stretches the letter spacing so a
	   single word runs exactly edge to edge at any paper size ----*/
	.specimen__fill {
		display: block;
		width: 100%;
		height: auto;
	}
	.specimen__fill text {
		fill: currentColor;
	}
	.specimen__fill--copperlate text {
		font-family: 'Copperplate', 'Papyrus', fantasy;
		font-size: 11px;
	}
	.specimen__fill--american text {
		font-family: Georgia, serif;
		font-weight: 700;
		font-size: 12px;
	}
</style>

---
import { LOCALES, DEFAULT_LOCALE, useTranslations, type Lang } from '../../i18n';
const t = useTranslations(Astro.currentLocale as Lang);
// Select drives the client-side switcher (src/scripts/i18n-client.ts) — no navigation
---
<select id="localeSelect" aria-label={t({ en: 'Language', es: 'Idioma', 'pt-br': 'Idioma' })}>
	{
		Object.entries(LOCALES).map(([lang, cfg]) => (
			<option value={lang} selected={lang === DEFAULT_LOCALE}>
				{cfg.label}
			</option>
		))
	}
</select>
<style>
	#localeSelect {
		background: none;
		border: 1px solid color-mix(in srgb, var(--text-color) 25%, transparent);
		border-radius: var(--radius-sm);
		padding: 0.1rem 0.3rem;
		font-size: 0.75rem;
		color: var(--text-color);
		cursor: pointer;
	}
</style>
<script>
	function setupLocaleSelect() {
		const sel = document.getElementById('localeSelect') as HTMLSelectElement | null;
		if (!sel || sel.dataset.bound) return;
		sel.dataset.bound = 'true';
		const w = window as any;
		sel.value = w.__i18n?.lang ?? 'en';
		sel.addEventListener('change', () => w.__i18n?.setLocale(sel.value));
		window.addEventListener('locale-change', () => {
			sel.value = w.__i18n?.lang ?? 'en';
		});
	}
	document.addEventListener('astro:page-load', setupLocaleSelect);
</script>

---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { SITE_CONFIG } from 'src/consts';

import type { BrandType } from 'src/types/variants';
import { getLocalePaths, LOCALES, DEFAULT_LOCALE, type Lang } from 'src/i18n';

import '@styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ScrollUp from '@components/ScrollUp.astro';

interface Props {
	title: string;
	variant?: BrandType;
	description?: string;
	keywords?: string[];
	permalink?: string;
	/** Absolute canonical URL (used by /blog pages, which live on the subdomain) */
	canonical?: string;
	withHeader?: boolean;
	withFooter?: boolean;
	noLinks?: boolean;
	/** Full-viewport scroll-snap steps for each section (homepage) */
	snap?: boolean;
	/** Overrides the page language for routes outside the [lang] tree (blog posts) */
	lang?: Lang;
}

const {
	title,
	variant = 'radapls',
	description = SITE_CONFIG.description,
	keywords = SITE_CONFIG.keywords,
	withFooter = true,
	withHeader = true,
	noLinks,
	snap = false,
	canonical,
	lang,
} = Astro.props;

const locale = lang ?? (Astro.currentLocale as Lang | undefined) ?? DEFAULT_LOCALE;
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const showHeaderBack = !['', '/', '/en', '/es', '/pt-br'].includes(currentPath);
---

<!doctype html>
<html lang={LOCALES[locale].lang || locale} dir={LOCALES[locale].dir || null}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords.join(', ')} />
		<meta http-equiv="Permissions-Policy" content="interest-cohort=()" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		{
			canonical && (
				<>
					<link rel="canonical" href={canonical} />
					<meta property="og:type" content="article" />
					<meta property="og:title" content={title} />
					<meta property="og:description" content={description} />
					<meta property="og:url" content={canonical} />
				</>
			)
		}

		{
			!canonical &&
				getLocalePaths(Astro.url).map((props) => (
					<link
						rel="alternate"
						hreflang={LOCALES[props.lang].lang || props.lang}
						href={Astro.site?.origin + props.path}
					/>
				))
		}
		<!--==================== UNICONS ====================-->
		<link rel="icon" type="image/x-icon" href="/favicon.svg" />
		<link rel="icon" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="icon" sizes="512x512" href="/android-chrome-512x512.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

		<link
			rel="stylesheet"
			media="print"
			onload={`this.media='all'`}
			href="https://fonts.googleapis.com/css2?family=Allerta+Stencil&family=Limelight&family=Share+Tech+Mono&family=Poppins:wght@400;500;600&display=swap"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Allerta+Stencil&family=Limelight&family=Share+Tech+Mono&family=Poppins:wght@400;500;600&display=swap"
			/>
		</noscript>

		<link
			rel="stylesheet"
			type="text/css"
			media="print"
			onload={`this.media='all'`}
			href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
		/>
		<style is:inline>
			@font-face {
				font-family: 'devicon';
				font-display: swap;
			}
		</style>
		<title>{title}</title>
		<script is:inline>
			// Apply theme before first paint to avoid flash of wrong theme (FOUC)
			(() => {
				const stored = localStorage.getItem('theme');
				const theme =
					stored === 'dark' || stored === 'light'
						? stored
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				localStorage.setItem('theme', theme);
				document.documentElement.classList.toggle('dark', theme === 'dark');
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		{withHeader && <Header {variant} noLinks={noLinks} hideLocaleSelect={Boolean(canonical)} showBack={showHeaderBack} />}
		<main
			class:list={['main', { 'snap-page': snap }]}
			id="main"
			tabindex="-1"
			transition:animate={canonical ? 'none' : 'fade'}
		>
			<slot />
		</main>
		{withFooter && <Footer {variant} />}
		<ScrollUp />
	<script>
	import '../scripts/i18n-client';
</script>
</body>
</html>

<script>
	// Suppress global smooth-scroll during route navigation so the router's
	// scroll-to-top doesn't animate before the swap (the "scroll up then
	// navigate" glitch). Re-enabled once the new page is ready.
	document.addEventListener('astro:before-preparation', () => {
		document.documentElement.classList.add('is-navigating');
	});
	document.addEventListener('astro:page-load', () => {
		document.documentElement.classList.remove('is-navigating');
	});

	// Hide the fixed header while the footer is the current visible region.
	(() => {
		let footerObserver: IntersectionObserver | undefined;
		const observeFooter = () => {
			footerObserver?.disconnect();
			const footer = document.querySelector<HTMLElement>('footer.footer__bg');
			if (!footer) {
				document.documentElement.classList.remove('footer-active');
				return;
			}
			footerObserver = new IntersectionObserver(
				([entry]) => {
					if (!entry) return;
					document.documentElement.classList.toggle(
						'footer-active',
						entry.isIntersecting && entry.intersectionRatio >= 0.5,
					);
				},
				{ threshold: 0.5 },
			);
			footerObserver.observe(footer);
		};
		document.addEventListener('astro:page-load', observeFooter);
		observeFooter();
	})();

	// Page scrollbar: same treatment as the timeline's — the native bar is
	// hidden (no layout shift) and a thin overlay indicator fades in while
	// scrolling, out after a short idle. Attached to <html> so it survives
	// the router's body swaps.
	(() => {
		const bar = document.createElement('div');
		bar.className = 'page-scrollbar';
		const thumb = document.createElement('span');
		bar.appendChild(thumb);

		let hideTimer: ReturnType<typeof setTimeout>;
		const update = () => {
			if (!bar.isConnected) document.documentElement.appendChild(bar);
			const max = document.documentElement.scrollHeight - window.innerHeight;
			bar.style.display = max <= 0 ? 'none' : '';
			if (max <= 0) return;
			const height = Math.max(
				(window.innerHeight / document.documentElement.scrollHeight) * bar.clientHeight,
				48,
			);
			thumb.style.height = `${height}px`;
			thumb.style.transform = `translateY(${(window.scrollY / max) * (bar.clientHeight - height)}px)`;
		};
		const show = () => {
			bar.classList.add('is-visible');
			clearTimeout(hideTimer);
			hideTimer = setTimeout(() => bar.classList.remove('is-visible'), 900);
		};

		window.addEventListener(
			'scroll',
			() => {
				update();
				show();
			},
			{ passive: true },
		);
		window.addEventListener('resize', update);
		// Recalc for the new page's height after route/images/fonts settle.
		document.addEventListener('astro:page-load', () => setTimeout(update, 200));
		update();
	})();
</script>

<script>
	import '../scripts/i18n-client';
</script>

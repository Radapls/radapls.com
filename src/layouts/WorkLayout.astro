---
import Base from '@layouts/Layout.astro';

interface Props {
	title: string;
	description?: string;
	noLinks?: boolean;
	variant: any;
}

const { title, description, noLinks, variant } = Astro.props;
---

<Base {variant} {title} {description} {noLinks}>
	<article class="section container">
		<slot />
	</article>
</Base>

<style>
	/* Global .container went full-bleed; cap prose width for readability. */
	article {
		max-width: 768px;

		> * {
			margin-block: 1.2em 0;
			margin-inline: 0;
		}

		p {
			font-weight: 400;
			line-height: 1.75;
			margin-block: 1.5em 0;
		}

		h1 {
			font-size: 2rem;
			text-align: center;
			margin-block-start: 0.5em;
		}

		h2 {
			margin-block: 2.5em 0;
			padding-block-end: 0.2em;
			border-inline-start: 4px solid var(--first-color);
			padding-inline-start: var(--mb-1);
			line-height: 1.4;
			font-size: 1.6rem;
		}

		h3 {
			margin-block: 2em 0;
			padding-block-end: 0.2em;
			line-height: 1.4;
			font-size: 1.4rem;
		}

		h4 {
			margin-block: 2em -0.4em;
			line-height: 1.4;
			font-size: 1.1rem;
		}

		ul {
			list-style: disc;
			padding-inline-start: 1.5em;
		}
		ol {
			list-style: decimal;
			padding-inline-start: 1.5em;
		}
		li {
			margin-block: 0 0.5em;
			line-height: 1.4;
			ul,
			ol {
				margin-block: 0.5em 0;
			}
			ul {
				list-style: circle;
			}
			ol {
				list-style: decimal;
			}
		}

		dl {
			dt {
				margin-block-start: 1em;
				font-weight: 700;
				font-size: 1.1rem;
				&::after {
					content: ' :';
					opacity: 0.4;
				}
			}
		}

		table {
			width: 100%;
			th,
			td {
				border: 1px solid color-mix(in srgb, var(--first-color) 20%, transparent);
				padding-block: 0.4em;
				padding-inline: 0.8em;
			}
			th {
				background: color-mix(in srgb, var(--first-color) 20%, transparent);
			}
			tr:nth-child(even) td {
				background: color-mix(in srgb, var(--first-color) 2%, transparent);
			}
		}

		b {
			font-weight: 700;
		}

		strong {
			background: linear-gradient(
				transparent 60%,
				color-mix(in srgb, var(--first-color) 20%, transparent) 40%
			);
		}

		:not(pre) code {
			font-family: Consolas, 'Courier New', Courier, Monaco, monospace;
			color: var(--first-color);
			background-color: color-mix(in srgb, var(--first-color) 8%, transparent);
			padding-block: 0.2em;
			padding-inline: 0.4em;
			margin-block: auto;
			margin-inline: 0.2em;
			border-radius: 2px;
			font-size: 0.9rem;
			vertical-align: 0.2em;
		}

		blockquote {
			font-style: italic;
			color: color-mix(in srgb, var(--text-color) 80%, transparent);
			background: color-mix(in srgb, var(--first-color) 5%, transparent);
			padding: 1em;
			border-radius: 0.5rem;
			font-weight: 100;
			border-inline-start: 2px solid color-mix(in srgb, var(--first-color) 10%, transparent);
		}

		blockquote > p {
			margin: 0;
		}

		small {
			font-size: 0.9rem;
			opacity: 0.8;
			&.reference {
				width: 100%;
				text-align: right;
				display: block;
				margin-block-start: 0.4em;
				a {
					color: color-mix(in srgb, var(--first-color) 40%, transparent);
					text-decoration: underline;
				}
			}
		}

		hr {
			border: 0;
			margin-block: 6em 4em;
			border-block-start: 1px dashed color-mix(in srgb, var(--first-color) 40%, transparent);
		}

		a {
			text-decoration: underline;
			color: var(--first-color);
			font-weight: 500;
			&:visited {
				filter: brightness(80%);
			}
		}

		video {
			max-width: 100%;
			background-color: color-mix(in srgb, var(--first-color) 10%, transparent);
		}
		iframe {
			max-width: 100%;
		}
		iframe[src*='youtube'],
		iframe[src*='vimeo'] {
			max-width: 100%;
			aspect-ratio: 16 / 9;
			overflow: hidden;
			border-radius: 6px;
			height: auto;
		}

		pre {
			direction: ltr;
			padding: 1em;
			border-radius: 4px;
			border: 2px solid color-mix(in srgb, var(--first-color) 20%, transparent);
			code {
				counter-reset: step;
				counter-increment: step 0;
				span:empty {
					display: none;
				}
				.line::before {
					content: counter(step);
					counter-increment: step;
					width: 1em;
					margin-right: 1em;
					display: inline-block;
					text-align: right;
					color: #fff6;
				}
			}
		}

		details {
			background-color: color-mix(in srgb, var(--first-color) 8%, transparent);
			border: 0.12em solid color-mix(in srgb, var(--first-color) 10%, transparent);
			padding: var(--mb-1);
			border-radius: 10px;
			overflow: hidden;
			p:empty {
				display: none;
			}

			& summary {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				display: block;
				position: relative;
				margin: calc(-1 * var(--mb-1));
				padding: var(--mb-1);
				padding-inline-start: calc(var(--mb-1) + 1.8em);
				cursor: pointer;
				background-color: var(--container-color);
				line-height: 1.2;
				&::-webkit-details-marker {
					display: none;
				}
				&::before {
					content: '';
					display: block;
					position: absolute;
					inset: var(--mb-1);
					width: 1.2em;
					aspect-ratio: 1;
					background: color-mix(in srgb, var(--first-color) 20%, transparent);
					clip-path: polygon(10% 35%, 50% 75%, 90% 35%, 80% 25%, 50% 55%, 20% 25%);
					transition: 0.2s linear;
					transform-origin: center;
				}
			}

			&[open] summary {
				text-overflow: unset;
				white-space: unset;
				margin-block-end: var(--mb-1);
				&::before {
					rotate: x 180deg;
				}
			}
		}

		.footnotes {
			margin-block-start: 8em;
			padding-block-start: 2em;
			border-block-start: 1px solid color-mix(in srgb, var(--first-color) 20%, transparent);
			h2 {
				display: none;
			}
			a {
				&::before {
					content: ' [';
				}
				&::after {
					content: ']';
				}
				text-decoration: none;
				opacity: 0.8;
			}
		}
	}
</style>

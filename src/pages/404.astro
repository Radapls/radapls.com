---
import { DEFAULT_LOCALE, useTranslations } from 'src/i18n';
import Layout from '@layouts/Layout.astro';
import Logo from '@assets/img/JFRA.svg';

const t = useTranslations(DEFAULT_LOCALE);

const title = t({
	es: 'Página no encontrada',
	en: 'Page Not Found',
	'pt-br': 'Página não encontrada',
});

---

<Layout {title} withFooter={false} withHeader={false}>
	<section class="lost">
		<div class="lost__card">
			<Logo
				class="lost__logo"
				role="img"
				aria-label="Logo Juan Felipe Rada"
				width={44}
				height={44}
			/>

			<h1 class="lost__code" aria-label="404">404</h1>
			<p class="lost__title">{title}</p>

			<p class="lost__text">
				{
					t({
						es: 'La página que buscas no se pudo encontrar. Por favor, regresa al inicio.',
						en: 'The page you are looking for could not be found. Please return to the top.',
						'pt-br':
							'A página que você está procurando não foi encontrada. Por favor, volte ao início.',
					})
				}
			</p>

			<a href="/" class="lost__cta">
				{
					t({
						es: 'Página principal',
						en: 'Top Page',
						'pt-br': 'Página inicial',
					})
				}
				<i class="uil uil-estate" aria-hidden="true"></i>
			</a>
		</div>
	</section>
</Layout>

<script is:inline>
	// Restore the URL the visitor actually typed (set by the root 404 shim).
	if (localStorage.userAccessPath) {
		history.replaceState('', '', localStorage.userAccessPath);
		localStorage.removeItem('userAccessPath');
	}
</script>

<style>
	.lost {
		display: grid;
		place-items: center;
		min-height: 100vh;
		padding: 1.5rem;
	}

	.lost__card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5rem;
		max-width: 34rem;
		padding: 3rem 2.5rem;
		background: var(--container-color);
		border: 1px solid color-mix(in srgb, var(--first-color) 30%, transparent);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
	}

	.lost__logo {
		width: 44px;
		height: auto;
		margin-bottom: 0.75rem;
	}

	.lost__code {
		font-family: var(--title-font);
		font-size: clamp(5rem, 18vw, 8.5rem);
		font-weight: var(--font-bold);
		line-height: 0.9;
		color: var(--first-color);
	}

	.lost__title {
		font-size: var(--h2-font-size);
		font-weight: var(--font-semi-bold);
		color: var(--title-color);
	}

	.lost__text {
		color: var(--text-color);
		line-height: 1.6;
		margin-block: 0.5rem 1.5rem;
	}

	.lost__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.75rem;
		border-radius: var(--radius-pill);
		background: var(--first-color);
		color: #fff;
		font-weight: var(--font-semi-bold);
		letter-spacing: 0.03em;
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transition:
			background-color 200ms ease-in-out,
			transform 200ms ease-in-out;
	}
	.lost__cta:hover {
		background: var(--first-color-alt);
		transform: translateY(-2px);
	}
	.lost__cta i {
		font-size: 1.05rem;
	}
</style>

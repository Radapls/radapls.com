---
import { getCollection, render } from 'astro:content';
import Article from '@layouts/Article.astro';
import { BLOG_URL } from 'src/consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { id: post.id }, props: post }));
}

const post = Astro.props;
const { Content } = await render(post);
---

<Article
	title={post.data.title}
	description={post.data.description}
	canonical={`${BLOG_URL}/${post.id}/`}
	lang={post.data.lang}
>
	<header class="post-header">
		<h1>{post.data.title}</h1>
		<time datetime={post.data.pubDate.toISOString()}>
			{post.data.pubDate.toLocaleDateString(post.data.lang ?? 'en', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
		</time>
	</header>
	{
		post.data.cover && (
			<img class="cover" src={post.data.cover.src} alt="" width={post.data.cover.width} height={post.data.cover.height} />
		)
	}
	<Content />
</Article>

<style>
	.post-header {
		h1 {
			font-size: 1.8rem;
			line-height: 1.3;
			margin-block: 0 0.3em;
		}

		time {
			font-size: 0.9rem;
			opacity: 0.6;
		}
	}

	/* Short full-width banner: height-capped so portrait covers don't
	   tower over the text (object-fit crops instead of squashing) */
	.cover {
		display: block;
		width: 100%;
		max-height: 13rem;
		object-fit: cover;
		object-position: center;
		border-radius: 4px;
	}
</style>

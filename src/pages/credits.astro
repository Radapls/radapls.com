---
import Layout from '@layouts/Layout.astro';
import { DEFAULT_LOCALE, useTranslations } from 'src/i18n';


const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<Layout
	title={t('credits.credits-acknowledgments-juan-felipe-rada')}
	variant="radapls"
>
	<main class="credits section">
		<div class="container">
			<h1 class="section__title">
				{t('credits.credits-acknowledgments')}
			</h1>
			<p class="credits__intro">
				{t('credits.a-note-on-the-third-party-tools-and-serv')}
			</p>

			<section class="credits__group" aria-labelledby="credits-tools">
				<h2 id="credits-tools">{t('credits.tools-and-libraries')}</h2>
				<ul>
					<li><a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a> — {t('credits.website-framework')}</li>
					<li><a href="https://docs.astro.build/en/guides/integrations-guide/mdx/" target="_blank" rel="noopener noreferrer">Astro MDX</a>, <a href="https://docs.astro.build/en/guides/integrations-guide/rss/" target="_blank" rel="noopener noreferrer">RSS</a>, and <a href="https://docs.astro.build/en/guides/integrations-guide/sitemap/" target="_blank" rel="noopener noreferrer">Sitemap</a> integrations</li>
					<li><a href="https://www.npmjs.com/package/astro-critters" target="_blank" rel="noopener noreferrer">astro-critters</a> — {t('credits.critical-css-inlining')}</li>
					<li><a href="https://gsap.com/" target="_blank" rel="noopener noreferrer">GSAP</a> — {t('credits.animation-library')}</li>
					<li><a href="https://www.typescriptlang.org/" target="_blank" rel="noopener noreferrer">TypeScript</a> — {t('credits.programming-language-and-type-checking')}</li>
					<li><a href="https://sharp.pixelplumbing.com/" target="_blank" rel="noopener noreferrer">Sharp</a> — {t('credits.image-processing-during-builds')}</li>
					<li><a href="https://www.cypress.io/" target="_blank" rel="noopener noreferrer">Cypress</a>, <a href="https://prettier.io/" target="_blank" rel="noopener noreferrer">Prettier</a>, <a href="https://github.com/svg/svgo" target="_blank" rel="noopener noreferrer">SVGO</a>, and <a href="https://github.com/isaacs/rimraf" target="_blank" rel="noopener noreferrer">Rimraf</a> — {t('credits.development-utilities')}</li>
				</ul>
			</section>

			<section class="credits__group" aria-labelledby="credits-services">
				<h2 id="credits-services">{t('credits.external-services-and-assets')}</h2>
				<ul>
					<li><a href="https://fonts.google.com/" target="_blank" rel="noopener noreferrer">Google Fonts</a> — {t('credits.poppins-and-display-fonts')}</li>
					<li><a href="https://pangrampangram.com/products/gatwick-glider" target="_blank" rel="noopener noreferrer">PP Gatwick Glider</a> — {t('credits.title-typeface-used-under-a-personal-use')}</li>
					<li><a href="https://devicon.dev/" target="_blank" rel="noopener noreferrer">Devicon</a>, served by <a href="https://www.jsdelivr.com/" target="_blank" rel="noopener noreferrer">jsDelivr</a> — {t('credits.technology-icons')}</li>
					<li><a href="https://formsubmit.co/" target="_blank" rel="noopener noreferrer">FormSubmit</a> — {t('credits.contact-form-delivery')}</li>
					<li><a href="https://www.w3.org/WAI/WCAG2AA-Conformance" target="_blank" rel="noopener noreferrer">W3C</a> — {t('credits.source-of-the-wcag-badge-shown-in-the-fo')}</li>
				</ul>
			</section>
		</div>
	</main>
</Layout>

<style>
	.credits {
		min-height: 70vh;
		padding-block: 3rem 5rem;
	}
	.credits__intro {
		max-width: 48rem;
		margin: 0 auto 2.5rem;
		color: var(--text-color);
		line-height: 1.7;
		text-align: center;
	}
	.credits__group {
		max-width: 48rem;
		margin: 0 auto 2rem;
		padding: 1.5rem;
		background: var(--container-color);
		border: 1px solid color-mix(in srgb, var(--text-color) 12%, transparent);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}
	.credits__group h2 {
		margin-bottom: 0.75rem;
		color: var(--title-color);
		font-size: var(--h3-font-size);
	}
	.credits__group ul {
		padding-left: 1.25rem;
		color: var(--text-color);
		line-height: 1.9;
	}
	.credits__group a {
		color: var(--first-color);
	}
</style>

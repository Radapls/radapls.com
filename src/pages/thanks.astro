---
import Layout from '@layouts/Layout.astro';

import { useTranslations, DEFAULT_LOCALE } from 'src/i18n';

const t = useTranslations(DEFAULT_LOCALE);
const locale = DEFAULT_LOCALE;

---

<Layout title="Juan Felipe Rada | Thanks!" variant="radapls" withFooter={false} withHeader={false}>
	<!-- Matches the contact drawer's compose card: its "sent" dialog -->
	<main class="thanks">
		<div class="thanks__window">
			<div class="thanks__titlebar">
				<span class="thanks__dot" aria-hidden="true"></span>
				<span class="thanks__dot" aria-hidden="true"></span>
				<span class="thanks__dot" aria-hidden="true"></span>
				<span class="thanks__title">
					{
						t('thanks.message-sent')
					}
				</span>
			</div>

			<div class="thanks__body">
				<svg
					class="thanks__icon"
					viewBox="0 0 24 24"
					width="48"
					height="48"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="2" y="4" width="20" height="16" rx="2"></rect>
					<path d="m22 7-10 6L2 7"></path>
				</svg>
				<h1>
					{
						t('thanks.thank-you')
					}
				</h1>
				<p>
					{
						t('thanks.your-message-is-on-its-way-i-usually-rep')
					}
				</p>
				<a href={'/'} class="thanks__btn">
					<svg
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					{
						t('thanks.go-back-to-home')
					}
				</a>
			</div>
		</div>
	</main>

	<style>
		/* Matches the contact form's compose card (ContactDrawer.astro .mail) */
		.thanks {
			display: flex;
			justify-content: center;
			align-items: center;
			min-height: 70vh;
			padding: 2rem;
		}

		.thanks__window {
			width: min(100%, 30rem);
			padding: clamp(1.25rem, 4vw, 2rem);
			display: grid;
			gap: 1.25rem;
			background: var(--container-color);
			border: 1px solid color-mix(in srgb, var(--text-color) 12%, transparent);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-md);
		}

		.thanks__titlebar {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			padding-bottom: 0.9rem;
			border-bottom: 1px solid color-mix(in srgb, var(--text-color) 12%, transparent);
		}
		.thanks__dot {
			display: none;
		}
		.thanks__title {
			flex: 1;
			font-size: var(--h3-font-size);
			font-weight: var(--font-semi-bold);
			color: var(--title-color);
		}

		.thanks__body {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
		.thanks__icon {
			color: var(--first-color);
			margin-bottom: 1rem;
		}
		h1 {
			font-family: var(--title-font);
			font-size: 2rem;
			color: var(--title-color);
			margin-bottom: 0.75rem;
		}
		p {
			font-size: var(--normal-font-size);
			line-height: 1.6;
			color: var(--text-color);
			margin-bottom: 1.5rem;
		}

		/* Same send button as the compose window */
		.thanks__btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.7rem 1.25rem;
			font-size: var(--small-font-size);
			font-weight: var(--font-semi-bold);
			font-family: var(--body-font);
			color: #fff;
			background-color: var(--first-color-deep, var(--first-color));
			border: 0;
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-sm);
			text-decoration: none;
			cursor: pointer;
			transition: background-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
		}
		.thanks__btn:hover {
			background-color: var(--first-color-deep-alt, var(--first-color-alt));
			box-shadow: var(--shadow-md);
			transform: translateY(-1px);
		}
		.thanks__btn:active {
			transform: translateY(0);
		}
	</style>
</Layout>

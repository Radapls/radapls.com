---
import Flag from '@components/Flag.astro';
import TypeSpecimen from '@components/TypeSpecimen.astro';
import Moai from '@components/Moai.astro';
import RaceBibs from '@components/RaceBibs.astro';
import Logo from '@assets/img/JFRA.svg';
import Illustration from '@assets/img/illustration.webp';
import CuerposDeAguaCover from '@assets/img/publications/cuerpos-de-agua.png';
import CuerposDeAguaPdf from '@assets/documents/Trujillo_cuerpos_y_agua.pdf?url';
import EnClavesDePazPdf from '@assets/documents/en-claves-de-paz-no-5.pdf?url';
import EnClavesDePazPage5 from '@assets/img/publications/en-claves-de-paz-page-5.png';
import BugaPoliticsCover from '@assets/img/publications/descomposicion-politica-buga.png';
import BugaPoliticsPdf from '@assets/documents/la-descomposicion-organizaciones-politicas-buga.pdf?url';
import PasaLaVozPage from '@assets/img/publications/pasa-la-voz-page-46.jpg';
import PasaLaVozArchiveCopy from '@assets/documents/revista-pasa-la-voz-edicion-23-archive-copy.pdf?url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { BLOG_URL } from 'src/consts';

import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
const publications = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const documentPublications = [
	{
		title: 'Cuerpos de agua',
		type: t({ en: 'PDF publication', es: 'Publicación en PDF', 'pt-br': 'Publicação em PDF' }),
		cover: CuerposDeAguaCover,
		pdf: CuerposDeAguaPdf,
		contributor: '',
		alt: t({
			en: 'Poster for Trujillo: Cuerpos de agua',
			es: 'Afiche de Trujillo: Cuerpos de agua',
			'pt-br': 'Pôster de Trujillo: Cuerpos de agua',
		}),
	},
	{
		title: 'En - claves de paz · Boletín No. 5',
		type: t({ en: 'Peace bulletin', es: 'Boletín de paz', 'pt-br': 'Boletim pela paz' }),
		cover: EnClavesDePazPage5,
		pdf: EnClavesDePazPdf,
		alt: 'Page 5 of the En-claves de paz bulletin, showing the poem “Participaz” by Juan Felipe Rada',
		contributor: t({
			en: 'By Juan Felipe Rada',
			es: 'Por Juan Felipe Rada',
			'pt-br': 'Por Juan Felipe Rada',
		}),
	},
	{
		title:
			'La descomposición de las organizaciones políticas en Buga en las contiendas electorales (1997–2003) y la relación entre paramilitares y políticos',
		type: t({
			en: 'Undergraduate thesis',
			es: 'Trabajo de grado',
			'pt-br': 'Trabalho de conclusão de curso',
		}),
		cover: BugaPoliticsCover,
		pdf: BugaPoliticsPdf,
		alt: t({
			en: 'Title page of a political science thesis about political organizations and elections in Buga',
			es: 'Portada del trabajo de grado sobre organizaciones políticas y elecciones en Buga',
			'pt-br': 'Capa do trabalho de conclusão sobre organizações políticas e eleições em Buga',
		}),
		contributor: t({
			en: 'Co-authored by Juan Felipe Rada Arias',
			es: 'En coautoría con Juan Felipe Rada Arias',
			'pt-br': 'Em coautoria com Juan Felipe Rada Arias',
		}),
	},
	{
		title: 'Te sueñen Sans Serifa',
		type: t({
			en: 'Poem · Pasá la Voz magazine',
			es: 'Poema · Revista Pasá la Voz',
			'pt-br': 'Poema · Revista Pasá la Voz',
		}),
		cover: PasaLaVozPage,
		pdf: PasaLaVozArchiveCopy,
		alt: 'Page 46 of Revista Pasá la Voz, showing the poem “Te sueñen Sans Serifa” by Juan Felipe Rada Arias',
		contributor: t({
			en: 'Poem by Juan Felipe Rada Arias · 23rd edition, p. 46 · 48-page archive copy',
			es: 'Poema de Juan Felipe Rada Arias · 23.ª edición, p. 46 · Copia de archivo de 48 páginas',
			'pt-br': 'Poema de Juan Felipe Rada Arias · 23ª edição, p. 46 · Cópia de arquivo com 48 páginas',
		}),
	},
];
const funFacts = [
	t({
		en: 'Political scientist by training',
		es: 'Politólogo de formación',
		'pt-br': 'Cientista político por formação',
	}),
	t({
		en: 'Curious coder by nature',
		es: 'Programador curioso por naturaleza',
		'pt-br': 'Programador curioso por natureza',
	}),
	t({
		en: 'Digital business strategist',
		es: 'Estratega de negocios digitales',
		'pt-br': 'Estrategista de negócios digitais',
	}),
	t({
		en: 'I write poems and personal essays',
		es: 'Escribo poemas y textos personales',
		'pt-br': 'Escrevo poemas e textos pessoais',
	}),
	t({
		en: 'I collect race bibs as running souvenirs',
		es: 'Colecciono dorsales como recuerdos de carreras',
		'pt-br': 'Coleciono números de corrida como lembranças',
	}),
];
---

<section class="about-hero section" aria-labelledby="about-title">
	<div class="container layout-grid">
		<header class="about__hero layout-center">
			<h1 class="section__title" id="about-title">
				{
					t({
						en: 'About',
						es: 'Acerca de mí',
						'pt-br': 'Sobre mim',
					})
				}
			</h1>
			<p class="about__summary">
				{
					t({
						en: 'Brazil-based multidisciplinary humanist exploring the connections between the humanities, design, and code.',
						es: 'Humanista multidisciplinario radicado en Brasil, explorando las conexiones entre las humanidades, el diseño y el código.',
						'pt-br':
							'Humanista multidisciplinar baseado no Brasil, explorando as conexões entre humanidades, design e programação.',
					})
				}
			</p>
		</header>
	</div>
</section>

<section
	class="about section"
	id="About"
	aria-label={t({ en: 'My room', es: 'Mi habitación', 'pt-br': 'Meu quarto' })}
>
	<div class="about__container container layout-grid layout-items-start">
		<header class="about-section-heading layout-full">
			<p class="about-section-kicker">01</p>
			<h2>{t({ en: 'Moodboard', es: 'Moodboard', 'pt-br': 'Painel de referências' })}</h2>
		</header>
		<div
			class="about__gallery layout-full"
			role="group"
			aria-label={t({
				en: 'A few things from my room',
				es: 'Algunas cosas de mi habitación',
				'pt-br': 'Algumas coisas do meu quarto',
			})}
		>
			<div class="about__portrait-core">
				<Image
					class="about__portrait"
					alt={t({
						en: 'Digital illustration of Juan Felipe Rada',
						es: 'Ilustración digital de Juan Felipe Rada',
						'pt-br': 'Ilustração digital de Juan Felipe Rada',
					})}
					src={Illustration}
					widths={[240, 352, 480]}
					sizes="(max-width: 767px) 180px, 240px"
					loading="lazy"
					decoding="async"
				/>
			</div>

			<article
				class="about__orbit-item about__orbit-item--moai"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-moai"
				aria-label={t({
					en: 'A moai from my room',
					es: 'Un moái de mi habitación',
					'pt-br': 'Um moai do meu quarto',
				})}
				aria-describedby="about-note-moai"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview about__moai" id="about-preview-moai"><Moai /></div>
				<p class="about__orbit-note" id="about-note-moai">
					{
						t({
							en: 'A small stone Moai, kept close among the things that make my room feel like mine.',
							es: 'Un pequeño moái de piedra, entre las cosas que hacen que mi habitación se sienta propia.',
							'pt-br':
								'Um pequeno moai de pedra, entre as coisas que fazem meu quarto ter a minha cara.',
						})
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--type"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-type"
				aria-label={t({
					en: 'Typography specimen poster',
					es: 'Póster de muestras tipográficas',
					'pt-br': 'Pôster de amostras tipográficas',
				})}
				aria-describedby="about-note-type"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview" id="about-preview-type"><TypeSpecimen /></div>
				<p class="about__orbit-note" id="about-note-type">
					{
						t({
							en: 'A specimen poster for the typefaces I keep coming back to.',
							es: 'Un muestrario de las tipografías a las que siempre vuelvo.',
							'pt-br': 'Um mostruário das tipografias às quais sempre volto.',
						})
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--bibs"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-bibs"
				aria-label={t({
					en: 'Race bib collection',
					es: 'Colección de dorsales',
					'pt-br': 'Coleção de números de corrida',
				})}
				aria-describedby="about-note-bibs"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview" id="about-preview-bibs">
					<RaceBibs class="about__orbit-bibs" />
				</div>
				<p class="about__orbit-note" id="about-note-bibs">
					{
						t({
							en: 'Each bib marks a race, a route, and a finish line.',
							es: 'Cada dorsal marca una carrera, una ruta y una meta.',
							'pt-br': 'Cada número marca uma corrida, um percurso e uma linha de chegada.',
						})
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--flag"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-flag"
				aria-label={t({
					en: 'A phrase I keep on my wall',
					es: 'Una frase que tengo en mi pared',
					'pt-br': 'Uma frase que mantenho na parede',
				})}
				aria-describedby="about-note-flag"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview" id="about-preview-flag"><Flag /></div>
				<p class="about__orbit-note" id="about-note-flag">
					{
						t({
							en: 'A reminder to stay curious and make room for good encounters.',
							es: 'Un recordatorio para mantener la curiosidad y abrir espacio a buenos encuentros.',
							'pt-br': 'Um lembrete para manter a curiosidade e abrir espaço para bons encontros.',
						})
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--quote about__orbit-item--lower"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-quote"
				aria-label={t({
					en: 'A note about my work and writing',
					es: 'Una nota sobre mi trabajo y escritura',
					'pt-br': 'Uma nota sobre meu trabalho e minha escrita',
				})}
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<svg
					class="about__idea-bulb"
					viewBox="0 0 48 48"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M16.5 29.5a13 13 0 1 1 15 0c-2 1.4-3 3.1-3.2 5.5h-8.6c-.2-2.4-1.2-4.1-3.2-5.5ZM20 39h8m-7 4h6"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<path
						d="M24 8v4m12 1.5-3 3M12 13.5l3 3"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
					/>
				</svg>
				<blockquote class="about__intro about__quote-preview" id="about-preview-quote">
					<p class="about__lead">
						{
							t({
								en: 'I work as a UI/UX developer in telecommunications, paying attention to the small interface details that shape people’s experience. Across different technology sectors, I try to bring a human touch to development.',
								es: 'Trabajo como desarrollador UI/UX en telecomunicaciones y me fijo en los pequeños detalles de interfaz que transforman la experiencia. En distintos sectores tecnológicos, intento aportar un enfoque humano al desarrollo.',
								'pt-br':
									'Trabalho como desenvolvedor UI/UX em telecomunicações, atento aos pequenos detalhes de interface que moldam a experiência das pessoas. Em diferentes setores de tecnologia, tento trazer um olhar humano para o desenvolvimento.',
							})
						}
					</p>
					<p class="about__lead">
						{
							t({
								en: 'I also write. My opinions are personal, shaped by an intimate point of view.',
								es: 'También escribo. Mis opiniones son personales y parten de una mirada íntima.',
								'pt-br':
									'Também escrevo. Minhas opiniões são pessoais e partem de uma perspectiva íntima.',
							})
						}
					</p>
				</blockquote>
			</article>

			<a
				rel="nofollow"
				href="/CV_Juan_Felipe_Rada.pdf"
				target="_blank"
				class="about__poster about__orbit-item about__orbit-item--cv"
				aria-label={t({ en: 'Download CV', es: 'Descargar CV', 'pt-br': 'Baixar CV' })}
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<span class="about__poster-frame">
					<Logo class="about__poster-logo" role="img" aria-hidden="true" width={44} height={44} />
					<span class="about__poster-text" aria-hidden="true"></span>
					<span class="about__poster-text about__poster-text--short" aria-hidden="true"></span>
					<span class="about__poster-text" aria-hidden="true"></span>
					<span class="about__poster-hint">
						{t({ en: 'Download CV', es: 'Descargar CV', 'pt-br': 'Baixar CV' })}
						<i class="uil uil-external-link-alt" aria-hidden="true"></i>
					</span>
				</span>
			</a>
		</div>
	</div>
</section>

<section class="about-publications section" aria-labelledby="publications-title">
	<div class="container layout-grid">
		<header class="about-section-heading layout-full">
			<p class="about-section-kicker">02</p>
			<h2 id="publications-title">
				{t({ en: 'Publications', es: 'Publicaciones', 'pt-br': 'Publicações' })}
			</h2>
		</header>
		<div class="publication-grid layout-full">
			{
				documentPublications.map((publication) => (
					<article class="publication-document">
						<a href={publication.pdf} target="_blank" rel="noopener noreferrer">
							<Image
								class="publication-document__cover"
								src={publication.cover}
								alt={publication.alt}
								widths={[320, 480, 640, 800]}
								sizes="(max-width: 767px) 90vw, (max-width: 1199px) 40vw, 40vw"
								loading="lazy"
								decoding="async"
							/>
							<div class="publication-document__details">
								<p>
									{publication.type}
								</p>
								<h3>{publication.title}</h3>
								{publication.contributor && <p>{publication.contributor}</p>}
								<span>
									{t({ en: 'View publication', es: 'Ver publicación', 'pt-br': 'Ver publicação' })}
									<span aria-hidden="true">↗</span>
								</span>
							</div>
						</a>
						{publication.pdf === PasaLaVozArchiveCopy && (
							<a
								class="publication-document__source"
								href="https://web.archive.org/web/20230227202541/https://issuu.com/comitepasalavoz/docs/revista_pas__la_voz_edici_n_23___2_"
								target="_blank"
								rel="noopener noreferrer"
							>
								{t({ en: 'Archived Issuu source', es: 'Fuente archivada en Issuu', 'pt-br': 'Fonte arquivada no Issuu' })}
							</a>
						)}
					</article>
				))
			}
			{
				publications.map((publication) => (
					<article class="publication-card">
						<p class="publication-meta">
							<span>
								{publication.data.type === 'poem'
									? t({ en: 'Poem', es: 'Poema', 'pt-br': 'Poema' })
									: t({ en: 'Essay', es: 'Ensayo', 'pt-br': 'Ensaio' })}
							</span>
							<time datetime={publication.data.pubDate.toISOString()}>
								{publication.data.pubDate.toLocaleDateString(publication.data.lang ?? 'en', {
									year: 'numeric',
									month: 'short',
								})}
							</time>
						</p>
						<h3>
							<a href={`${BLOG_URL}/${publication.id}/`} target="_blank" rel="noopener noreferrer">
								{publication.data.title}
								<span aria-hidden="true">↗</span>
							</a>
						</h3>
					</article>
				))
			}
		</div>
		<a
			class="about-more-writing layout-full"
			href={`${BLOG_URL}/`}
			target="_blank"
			rel="noopener noreferrer"
		>
			{
				t({
					en: 'Read all my writing',
					es: 'Lee todos mis textos',
					'pt-br': 'Leia todos os meus textos',
				})
			}
			<span aria-hidden="true">↗</span>
		</a>
	</div>
</section>

<section class="about-facts section" aria-labelledby="facts-title">
	<div class="container layout-grid">
		<header class="about-section-heading layout-full">
			<p class="about-section-kicker">03</p>
			<h2 id="facts-title">
				{t({ en: 'Fun facts', es: 'Datos curiosos', 'pt-br': 'Curiosidades' })}
			</h2>
		</header>
		<ul class="fact-grid layout-full">
			{
				funFacts.map((fact, index) => (
					<li class="fact-card">
						<>
							<span>0{index + 1}</span>
							<p>{fact}</p>
						</>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/*==================== ABOUT (a wall of my room) ====================*/
	#About {
		--layout-max-width: 82rem;
		--layout-gap: clamp(1.25rem, 3vw, 2.5rem);
	}
	.about-hero,
	.about-publications,
	.about-facts {
		--layout-max-width: 82rem;
	}
	.about-hero.section {
		min-height: min(72svh, 50rem);
		display: grid;
		align-content: center;
	}
	.about__hero {
		width: 100%;
		margin-inline: auto;
		text-align: center;
	}
	.about__hero .section__title {
		margin-bottom: 0.75rem;
		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}
	.about__summary {
		max-width: 48rem;
		margin-inline: auto;
		font-size: clamp(1rem, 2vw, 1.35rem);
		line-height: 1.45;
		color: var(--text-color-light);
	}
	.about-section-heading {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: clamp(1.5rem, 4vw, 3rem);
		padding-bottom: 0.75rem;
		border-bottom: 1px solid color-mix(in srgb, var(--title-color) 20%, transparent);
	}
	.about-section-heading h2 {
		font-size: clamp(2rem, 5vw, 3.75rem);
		line-height: 1;
		letter-spacing: -0.045em;
	}
	.about-section-kicker {
		font-family: 'Share Tech Mono', monospace;
		font-size: var(--small-font-size);
		color: var(--first-color);
	}
	.about-publications {
		--layout-max-width: 94rem;
		--layout-gap: clamp(1rem, 2vw, 1.5rem);
		background: color-mix(in srgb, var(--container-color) 45%, transparent);
	}
	.publication-grid,
	.fact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--layout-card-min, 16rem)), 1fr));
		gap: var(--layout-gap);
	}
	.publication-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.publication-card {
		min-height: 12rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding: clamp(1.25rem, 2.5vw, 2rem);
		border: 1px solid color-mix(in srgb, var(--title-color) 18%, transparent);
		border-radius: var(--radius-md);
		background: var(--body-color);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}
	.publication-card:hover {
		transform: translateY(-3px);
		border-color: var(--first-color);
	}
	.publication-document {
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--title-color) 18%, transparent);
		border-radius: var(--radius-md);
		background: var(--body-color);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}
	.publication-document:hover {
		transform: translateY(-3px);
		border-color: var(--first-color);
	}
	.publication-document > a {
		display: flex;
		height: 100%;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}
	.publication-document__source {
		display: block;
		padding: 0 1.5rem 1.25rem;
		font-size: var(--smaller-font-size);
		color: var(--first-color);
	}
	.publication-document__cover {
		display: block;
		width: 100%;
		height: min(78svh, 46rem);
		object-fit: contain;
		background: #fff;
	}
	.publication-document__details {
		display: grid;
		gap: 0.75rem;
		padding: clamp(1.1rem, 2vw, 1.5rem);
	}
	.publication-document__details > p {
		font-size: var(--smaller-font-size);
		color: var(--text-color-light);
	}
	.publication-document__details h3 {
		font-size: clamp(1.35rem, 2.3vw, 1.75rem);
		line-height: 1.15;
	}
	.publication-document__details > span {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 0.75rem;

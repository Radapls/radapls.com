	/* CV as a framed document hanging on the wall: nail + string + frame
	   with the JFRA logo and text lines, slightly tilted like it was
	   just hung. Decorative bits are aria-hidden pseudo-elements/spans
	   inside a labelled link. */
	.about__poster {
		position: relative;
		flex-shrink: 0;
		display: flex;
		justify-content: center;
		padding-top: 2.5rem; /* room for the nail and string */
		text-decoration: none;
	}
	/* the nail: sits on the wall, never moves */
	.about__poster::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		width: 9px;
		height: 9px;
		transform: translateX(-50%);
		border-radius: 50%;
		background: var(--title-color);
	}
	.about__poster-frame {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.65rem;
		width: 10rem;
		padding: 1.5rem 1.1rem 1.1rem;
		background: var(--container-color);
		border: 2px solid var(--title-color);
		/* inner mat, like a picture frame */
		box-shadow:
			inset 0 0 0 5px var(--body-color),
			inset 0 0 0 6px color-mix(in srgb, var(--title-color) 35%, transparent),
			var(--shadow-md);
		/* the frame hangs from the nail: it pivots on the nail point
		   (top of the strings, above the frame), not its own center —
		   hover straightens the swing while the nail stays put */
		transform-origin: 50% -2.4rem;
		transform: rotate(2.5deg);
		transition: transform 250ms ease-in-out;
	}
	.about__poster:hover .about__poster-frame {
		transform: rotate(0deg);
	}
	/* the string: two lines anchored at the nail (frame top center)
	   and rotating outward toward the frame — both start exactly at
	   the nail so they connect */
	.about__poster-frame::before,
	.about__poster-frame::after {
		content: '';
		position: absolute;
		top: -2.4rem;
		left: 50%;
		height: 2.45rem;
		width: 1px;
		background: var(--text-color);
		opacity: 0.5;
		transform-origin: top center;
	}
	.about__poster-frame::before {
		transform: rotate(38deg);
	}
	.about__poster-frame::after {
		transform: rotate(-38deg);
	}
	.about__poster-logo {
		width: 44px;
		height: auto;
	}

---
import Flag from '@components/Flag.astro';
import TypeSpecimen from '@components/TypeSpecimen.astro';
import Moai from '@components/Moai.astro';
import RaceBibs from '@components/RaceBibs.astro';
import Logo from '@assets/img/JFRA.svg';
import Illustration from '@assets/img/illustration.webp';
import CuerposDeAguaCover from '@assets/img/publications/cuerpos-de-agua.png';
import CuerposDeAguaPdf from '@assets/documents/Trujillo_cuerpos_y_agua.pdf?url';
import EnClavesDePazPdf from '@assets/documents/en-claves-de-paz-no-5.pdf?url';
import EnClavesDePazPage5 from '@assets/img/publications/en-claves-de-paz-page-5.png';
import BugaPoliticsCover from '@assets/img/publications/descomposicion-politica-buga.png';
import BugaPoliticsPdf from '@assets/documents/la-descomposicion-organizaciones-politicas-buga.pdf?url';
import PasaLaVozPage from '@assets/img/publications/pasa-la-voz-page-46.jpg';
import PasaLaVozArchiveCopy from '@assets/documents/revista-pasa-la-voz-edicion-23-archive-copy.pdf?url';
import ArtDecoPoster from '@assets/img/posters/SAMCRO Art Deco-01.png';
import ConstructivismPoster from '@assets/img/posters/SAMCRO Constructivismo-01.png';
import JaponismPoster from '@assets/img/posters/SAMCRO Japonismo-01.png';
import PsychedeliaPoster from '@assets/img/posters/SAMCRO Psicodelia-01.png';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { BLOG_URL } from 'src/consts';

import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
const publications = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const documentPublications = [
	{
		title: 'Cuerpos de agua',
		type: t('about.pdf-publication'),
		cover: CuerposDeAguaCover,
		pdf: CuerposDeAguaPdf,
		contributor: '',
		alt: t('about.poster-for-trujillo-cuerpos-de-agua'),
	},
	{
		title: 'En - claves de paz · Boletín No. 5',
		type: t('about.peace-bulletin'),
		cover: EnClavesDePazPage5,
		pdf: EnClavesDePazPdf,
		alt: 'Page 5 of the En-claves de paz bulletin, showing the poem “Participaz” by Juan Felipe Rada',
		contributor: t('about.by-juan-felipe-rada'),
	},
	{
		title:
			'La descomposición de las organizaciones políticas en Buga en las contiendas electorales (1997–2003) y la relación entre paramilitares y políticos',
		type: t('about.undergraduate-thesis'),
		cover: BugaPoliticsCover,
		pdf: BugaPoliticsPdf,
		alt: t('about.title-page-of-a-political-science-thesis'),
		contributor: t('about.co-authored-by-juan-felipe-rada-arias'),
	},
	{
		title: 'Te sueñen Sans Serifa',
		type: t('about.poem-pasa-la-voz-magazine'),
		cover: PasaLaVozPage,
		pdf: PasaLaVozArchiveCopy,
		alt: 'Page 46 of Revista Pasá la Voz, showing the poem “Te sueñen Sans Serifa” by Juan Felipe Rada Arias',
		contributor: t('about.poem-by-juan-felipe-rada-arias-23rd-edit'),
	},
];
const funFacts = [
	t('about.political-scientist-by-training'),
	t('about.curious-coder-by-nature'),
	t('about.digital-business-strategist'),
	t('about.i-write-poems-and-personal-essays'),
	t('about.i-collect-race-bibs-as-running-souvenirs'),
];
const posters = [
	{
		src: ArtDecoPoster,
		alt: t({
			en: 'Art Deco poster made at university',
			es: 'Póster art déco hecho en la universidad',
			'pt-br': 'Pôster art déco feito na universidade',
		}),
	},
	{
		src: ConstructivismPoster,
		alt: t({
			en: 'Constructivist poster made at university',
			es: 'Póster constructivista hecho en la universidad',
			'pt-br': 'Pôster construtivista feito na universidade',
		}),
	},
	{
		src: JaponismPoster,
		alt: t({
			en: 'Japonism poster made at university',
			es: 'Póster japonista hecho en la universidad',
			'pt-br': 'Pôster japonista feito na universidade',
		}),
	},
	{
		src: PsychedeliaPoster,
		alt: t({
			en: 'Psychedelia poster made at university',
			es: 'Póster psicodélico hecho en la universidad',
			'pt-br': 'Pôster psicodélico feito na universidade',
		}),
	},
];
---

<section class="about-hero section" aria-labelledby="about-title">
	<div class="container layout-grid">
		<header class="about__hero layout-center">
			<h1 class="section__title" id="about-title">
				{
					t('about.about')
				}
			</h1>
			<p class="about__summary">
				{
					t('about.brazil-based-multidisciplinary-humanist-')
				}
			</p>
		</header>
	</div>
</section>

<section
	class="about section"
	id="About"
	aria-label={t('about.my-room')}
>
	<div class="about__container container layout-grid layout-items-start">
		<header class="about-section-heading layout-full">
			<p class="about-section-kicker">01</p>
			<h2>{t('about.moodboard')}</h2>
		</header>
		<div
			class="about__gallery layout-full"
			role="group"
			aria-label={t('about.a-few-things-from-my-room')}
		>
			<div class="about__portrait-core">
				<Image
					class="about__portrait"
					alt={t('about.digital-illustration-of-juan-felipe-rada')}
					src={Illustration}
					widths={[240, 352, 480]}
					sizes="(max-width: 767px) 180px, 240px"
					loading="lazy"
					decoding="async"
				/>
			</div>

			<article
				class="about__orbit-item about__orbit-item--moai"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-moai"
				aria-label={t('about.a-moai-from-my-room')}
				aria-describedby="about-note-moai"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview about__moai" id="about-preview-moai"><Moai /></div>
				<p class="about__orbit-note" id="about-note-moai">
					{
						t('about.a-small-stone-moai-kept-close-among-the-')
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--type"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-type"
				aria-label={t('about.typography-specimen-poster')}
				aria-describedby="about-note-type"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview" id="about-preview-type"><TypeSpecimen /></div>
				<p class="about__orbit-note" id="about-note-type">
					{
						t('about.a-specimen-poster-for-the-typefaces-i-ke')
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--bibs"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-bibs"
				aria-label={t('about.race-bib-collection')}
				aria-describedby="about-note-bibs"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview" id="about-preview-bibs">
					<RaceBibs class="about__orbit-bibs" />
				</div>
				<p class="about__orbit-note" id="about-note-bibs">
					{
						t('about.each-bib-marks-a-race-a-route-and-a-fini')
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--flag"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-flag"
				aria-label={t('about.a-phrase-i-keep-on-my-wall')}
				aria-describedby="about-note-flag"
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<div class="about__orbit-preview" id="about-preview-flag"><Flag /></div>
				<p class="about__orbit-note" id="about-note-flag">
					{
						t('about.a-reminder-to-stay-curious-and-make-room')
					}
				</p>
			</article>

			<article
				class="about__orbit-item about__orbit-item--quote about__orbit-item--lower"
				role="button"
				tabindex="0"
				aria-expanded="false"
				aria-controls="about-preview-quote"
				aria-label={t('about.a-note-about-my-work-and-writing')}
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<blockquote class="about__intro about__quote-preview" id="about-preview-quote">
					<p class="about__lead">
						{
							t('about.i-work-as-a-ui-ux-developer-in-telecommu')
						}
					</p>
					<p class="about__lead">
						{
							t('about.i-also-write-my-opinions-are-personal-sh')
						}
					</p>
				</blockquote>
			</article>

			<a
				rel="nofollow"
				href="/CV_Juan_Felipe_Rada.pdf"
				target="_blank"
				class="about__poster about__orbit-item about__orbit-item--cv"
				aria-label={t('about.download-cv')}
			>
				<span class="about__orbit-orb" aria-hidden="true"></span>
				<span class="about__poster-frame">
					<Logo class="about__poster-logo" role="img" aria-hidden="true" width={44} height={44} />
					<span class="about__poster-text" aria-hidden="true"></span>
					<span class="about__poster-text about__poster-text--short" aria-hidden="true"></span>
					<span class="about__poster-text" aria-hidden="true"></span>
					<span class="about__poster-hint">
						{t('about.download-cv')}
						<i class="uil uil-external-link-alt" aria-hidden="true"></i>
					</span>
				</span>
			</a>
		</div>
	</div>
</section>

<section class="about-publications section" aria-labelledby="publications-title">
	<div class="container layout-grid">
		<header class="about-section-heading layout-full">
			<p class="about-section-kicker">02</p>
			<h2 id="publications-title">
				{t('about.publications')}
			</h2>
		</header>
		<div class="publication-grid layout-full">
			{
				documentPublications.map((publication) => (
					<article class="publication-document">
						<a href={publication.pdf} target="_blank" rel="noopener noreferrer">
							<Image
								class="publication-document__cover"
								src={publication.cover}
								alt={publication.alt}
								widths={[320, 480, 640, 800]}
								sizes="(max-width: 767px) 90vw, (max-width: 1199px) 40vw, 40vw"
								loading="lazy"
								decoding="async"
							/>
							<div class="publication-document__details">
								<p>
									{publication.type}
								</p>
								<h3>{publication.title}</h3>
								{publication.contributor && <p>{publication.contributor}</p>}
								<span>
									{t('about.view-publication')}
									<svg
										viewBox="0 0 24 24"
										width="14"
										height="14"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M7 17 17 7M8 7h9v9"></path>
									</svg>
								</span>
							</div>
						</a>
						{publication.pdf === PasaLaVozArchiveCopy && (
							<a
								class="publication-document__source"
								href="https://web.archive.org/web/20230227202541/https://issuu.com/comitepasalavoz/docs/revista_pas__la_voz_edici_n_23___2_"
								target="_blank"
								rel="noopener noreferrer"
							>
								{t('about.archived-issuu-source')}
							</a>
						)}
					</article>
				))
			}
			{
				publications.map((publication) => (
					<article class="publication-card">
						<p class="publication-meta">
							<span>
								{publication.data.type === 'poem'
									? t('about.poem')
									: t('about.essay')}
							</span>
							<time datetime={publication.data.pubDate.toISOString()}>
								{publication.data.pubDate.toLocaleDateString(publication.data.lang ?? 'en', {
									year: 'numeric',
									month: 'short',
								})}
							</time>
						</p>
						<h3>
							<a href={`${BLOG_URL}/${publication.id}/`} target="_blank" rel="noopener noreferrer">
								{publication.data.title}
								<svg
									viewBox="0 0 24 24"
									width="14"
									height="14"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M7 17 17 7M8 7h9v9"></path>
								</svg>
							</a>
						</h3>
					</article>
				))
			}
		</div>
		<a
			class="about-more-writing layout-full"
			href={`${BLOG_URL}/`}
			target="_blank"
			rel="noopener noreferrer"
		>
			{
				t('about.read-all-my-writing')
			}
			<svg
				viewBox="0 0 24 24"
				width="14"
				height="14"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M7 17 17 7M8 7h9v9"></path>
			</svg>
		</a>
	</div>
</section>

<section class="about-facts section" aria-labelledby="facts-title">
	<div class="container layout-grid">
		<header class="about-section-heading layout-full">
			<p class="about-section-kicker">03</p>
			<h2 id="facts-title">
				{t('about.fun-facts')}
			</h2>
		</header>
		<ul class="fact-grid layout-full">
			{
				funFacts.map((fact, index) => (
					<li class="fact-card">
						<>
							<span>0{index + 1}</span>
							<p>{fact}</p>
						</>
					</li>
				))
			}
		</ul>
		<div class="poster-strip layout-full">
			{
				posters.map((poster) => (
					<Image
						class="poster-strip__item"
						src={poster.src}
						alt={poster.alt}
						widths={[200, 400, 600]}
						sizes="(max-width: 767px) 45vw, 300px"
						loading="lazy"
						decoding="async"
					/>
				))
			}
		</div>
	</div>
</section>

<style>
	/*==================== ABOUT (a wall of my room) ====================*/
	#About {
		--layout-max-width: 82rem;
		--layout-gap: clamp(1.25rem, 3vw, 2.5rem);
	}
	.about-hero,
	.about-publications,
	.about-facts {
		--layout-max-width: 82rem;
	}
	.about-hero.section {
		min-height: min(72svh, 50rem);
		display: grid;
		align-content: center;
	}
	.about__hero {
		width: 100%;
		margin-inline: auto;
		text-align: center;
	}
	.about__hero .section__title {
		margin-bottom: 0.75rem;
		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}
	.about__summary {
		max-width: 48rem;
		margin-inline: auto;
		font-size: clamp(1rem, 2vw, 1.35rem);
		line-height: 1.45;
		color: var(--text-color-light);
	}
	.about-section-heading {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: clamp(1.5rem, 4vw, 3rem);
		padding-bottom: 0.75rem;
		border-bottom: 1px solid color-mix(in srgb, var(--title-color) 20%, transparent);
	}
	.about-section-heading h2 {
		font-size: clamp(2rem, 5vw, 3.75rem);
		line-height: 1;
		letter-spacing: -0.045em;
	}
	.about-section-kicker {
		font-family: 'Share Tech Mono', monospace;
		font-size: var(--small-font-size);
		color: var(--first-color);
	}
	.about-publications {
		--layout-max-width: 94rem;
		--layout-gap: clamp(1rem, 2vw, 1.5rem);
		background: color-mix(in srgb, var(--container-color) 45%, transparent);
	}
	.publication-grid,
	.fact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--layout-card-min, 16rem)), 1fr));
		gap: var(--layout-gap);
	}
	.publication-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.publication-card {
		min-height: 12rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding: clamp(1.25rem, 2.5vw, 2rem);
		border: 1px solid color-mix(in srgb, var(--title-color) 18%, transparent);
		border-radius: var(--radius-md);
		background: var(--body-color);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}
	.publication-card:hover {
		transform: translateY(-3px);
		border-color: var(--first-color);
	}
	.publication-document {
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--title-color) 18%, transparent);
		border-radius: var(--radius-md);
		background: var(--body-color);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}
	.publication-document:hover {
		transform: translateY(-3px);
		border-color: var(--first-color);
	}
	.publication-document > a {
		display: flex;
		height: 100%;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}
	.publication-document__source {
		display: block;
		padding: 0 1.5rem 1.25rem;
		font-size: var(--smaller-font-size);
		color: var(--first-color);
	}
	.publication-document__cover {
		display: block;
		width: 100%;
		height: min(78svh, 46rem);
		object-fit: contain;
		background: #fff;
	}
	.publication-document__details {
		display: grid;
		gap: 0.75rem;
		padding: clamp(1.1rem, 2vw, 1.5rem);
	}
	.publication-document__details > p {
		font-size: var(--smaller-font-size);
		color: var(--text-color-light);
	}
	.publication-document__details h3 {
		font-size: clamp(1.35rem, 2.3vw, 1.75rem);
		line-height: 1.15;
	}
	.publication-document__details > span {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 0.75rem;
		border-top: 1px solid color-mix(in srgb, var(--title-color) 18%, transparent);
		font-size: var(--small-font-size);
		font-weight: var(--font-medium);
	}
	.publication-document__details > span > span {
		color: var(--first-color);
	}
	.publication-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: var(--smaller-font-size);
		color: var(--text-color-light);
	}
	.publication-card h3 {
		font-size: clamp(1.2rem, 2.3vw, 1.75rem);
		line-height: 1.2;
	}
	.publication-card h3 a {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		color: inherit;
		text-decoration: none;
	}
	.publication-card h3 a span,
	.publication-card h3 a :global(svg),
	.about-more-writing span,
	.about-more-writing :global(svg) {
		color: var(--first-color);
	}
	.about-more-writing {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.5rem;
		color: var(--title-color);
		font-weight: var(--font-medium);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}
	@media screen and (max-width: 767px) {
		.publication-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.publication-document__cover {
			height: auto;
		}
	}
	.about-facts {
		--layout-card-min: 13rem;
	}
	.fact-grid {
		list-style: none;
	}
	.fact-card {
		min-height: 11rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding: clamp(1.25rem, 2.5vw, 2rem);
		border-top: 2px solid var(--first-color);
		background: color-mix(in srgb, var(--container-color) 70%, transparent);
	}
	.fact-card > span {
		font-family: 'Share Tech Mono', monospace;
		font-size: var(--small-font-size);
		color: var(--text-color-light);
	}
	.fact-card p {
		max-width: 18rem;
		font-size: clamp(1.2rem, 2vw, 1.6rem);
		font-weight: var(--font-medium);
		line-height: 1.25;
	}
	/* University posters: a row of frames under the fact cards */
	.poster-strip {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--layout-gap, 1.25rem);
		margin-top: var(--layout-gap, 1.25rem);
	}
	.poster-strip__item {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid color-mix(in srgb, var(--text-color) 14%, transparent);
		border-radius: var(--radius-sm, 4px);
		box-shadow: var(--shadow-sm);
	}
	@media (max-width: 767px) {
		.poster-strip {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	blockquote.about__intro {
		position: relative;
		display: grid;

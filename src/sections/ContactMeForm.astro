---
import { useTranslations, type Lang } from 'src/i18n';
import { GLOBAL_EMAIL, SITE_URL, WHATSAPP } from 'src/consts';

const t = useTranslations(Astro.currentLocale as Lang);
---

<section class="contact section" id="Contact">
	<h2 class="section__title">
		{
			t({
				en: 'Contact details',
				es: 'Datos de contacto',
				'pt-br': 'Dados de contato',
			})
		}
	</h2>

	<div class="container layout-stack layout-items-center">
		<form action={`https://formsubmit.co/${GLOBAL_EMAIL}`} method="POST" class="mail">
			<div class="mail__titlebar">
				<span class="mail__dot" aria-hidden="true"></span>
				<span class="mail__dot" aria-hidden="true"></span>
				<span class="mail__dot" aria-hidden="true"></span>
				<span class="mail__title">
					{
						t({
							en: 'New Message',
							es: 'Nuevo mensaje',
							'pt-br': 'Nova mensagem',
						})
					}
				</span>
			</div>

			<div class="mail__head">
				<div class="mail__row">
					<span class="mail__label">
						{t({ en: 'To:', es: 'Para:', 'pt-br': 'Para:' })}
					</span>
					<span class="mail__value">{GLOBAL_EMAIL}</span>
				</div>
				<div class="mail__row">
					<label class="mail__label" for="name">
						{t({ en: 'From:', es: 'De:', 'pt-br': 'De:' })}
					</label>
					<span class="mail__from">
						<input
							id="name"
							name="name"
							type="text"
							class="mail__input"
							placeholder={t({ en: 'Your name', es: 'Tu nombre', 'pt-br': 'Seu nome' })}
							autocomplete="name"
							required
						/>
						<input
							id="email"
							name="email"
							type="email"
							class="mail__input mail__input--email"
							placeholder="you@mail.com"
							autocomplete="email"
							required
						/>
					</span>
				</div>
				<div class="mail__row">
					<label class="mail__label" for="project">
						{t({ en: 'Subject:', es: 'Asunto:', 'pt-br': 'Assunto:' })}
					</label>
					<input
						id="project"
						name="project"
						type="text"
						class="mail__input"
						placeholder={t({
							en: 'Let&rsquo;s work together',
							es: 'Trabajemos juntos',
							'pt-br': 'Trabalhemos juntos',
						})}
					/>
				</div>
			</div>

			<textarea
				id="message"
				name="message"
				class="mail__body"
				rows="8"
				required
				wrap="soft"
				placeholder={t({
					en: 'Write your message here…',
					es: 'Escribe tu mensaje aquí…',
					'pt-br': 'Escreva sua mensagem aqui…',
				})}></textarea>

			<div class="mail__toolbar">
				<button type="submit" class="mail__send" id="submit-button">
					<svg
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 7-10 6L2 7"></path>
					</svg>
					{
						t({
							en: 'Send',
							es: 'Enviar',
							'pt-br': 'Enviar',
						})
					}
				</button>
			</div>

			<input type="hidden" name="_next" value={`${SITE_URL}/thanks`} />
			<input type="hidden" name="_subject" value="Nuevo mensaje de Portafolio" />
		</form>

		<a class="contact__alt" href={WHATSAPP as string}>
			{
				t({
					en: '…or text me on WhatsApp',
					es: '…o escríbeme por WhatsApp',
					'pt-br': '…ou me chama no WhatsApp',
				})
			}
		</a>
	</div>
</section>

<style>
	/*==================== CONTACT ====================*/
	#Contact {
		--layout-gap: 1.25rem;
	}
	.contact__alt {
		font-size: var(--small-font-size);
		color: var(--text-color-light);
		text-decoration: none;
		transition: color 180ms ease;
	}
	.contact__alt:hover {
		color: var(--first-color);
	}

	.mail {
		width: min(100%, 640px);
		padding: clamp(1.25rem, 4vw, 2rem);
		display: grid;
		gap: 1.25rem;
		background: var(--container-color);
		color: var(--text-color);
		border: 1px solid color-mix(in srgb, var(--text-color) 12%, transparent);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
	}

	.mail__titlebar {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid color-mix(in srgb, var(--text-color) 12%, transparent);
	}
	.mail__dot {
		display: none;
	}
	.mail__title {
		flex: 1;
		font-size: var(--h3-font-size);
		font-weight: var(--font-semi-bold);
		color: var(--title-color);
	}

	.mail__head {
		display: grid;
		gap: 0.75rem;
	}
	.mail__row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}
	.mail__label {
		flex: none;
		width: 4.25rem;
		font-size: var(--small-font-size);
		font-weight: var(--font-semi-bold);
		color: var(--text-color-light);
	}
	.mail__value {
		font-size: var(--small-font-size);
		color: var(--text-color);
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.mail__from {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex: 1;
		min-width: 0;
		color: var(--text-color-light);
	}
	.mail__input {
		min-width: 0;
		flex: 1;
		background-color: var(--input-color);
		border: 1px solid color-mix(in srgb, var(--text-color) 16%, transparent);
		border-radius: var(--radius-md);
		font-size: var(--small-font-size);
		font-family: var(--body-font);
		color: var(--text-color);
		padding: 0.65rem 0.75rem;
		transition: border-color 180ms ease, box-shadow 180ms ease;
	}
	.mail__input:focus-visible,
	.mail__body:focus-visible {
		outline: 2px solid var(--first-color);
		outline-offset: 2px;
		border-color: var(--first-color);
	}
	.mail__input::placeholder {
		color: var(--text-color-light);
	}

	.mail__body {
		display: block;
		width: 100%;
		border: 1px solid color-mix(in srgb, var(--text-color) 16%, transparent);
		border-radius: var(--radius-md);
		background-color: var(--input-color);
		resize: vertical;
		min-height: 10rem;
		padding: 0.75rem;
		font-family: var(--body-font);
		font-size: var(--normal-font-size);
		line-height: 1.5;
		color: var(--text-color);
	}
	.mail__body::placeholder {
		color: var(--text-color-light);
	}

	.mail__toolbar {
		display: flex;
		justify-content: flex-end;
	}
	.mail__send {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.25rem;
		font-size: var(--small-font-size);
		font-weight: var(--font-semi-bold);
		font-family: var(--body-font);
		color: #fff;
		background-color: var(--first-color-deep, var(--first-color));
		border: 0;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
		cursor: pointer;
		transition: background-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
	}
	.mail__send:hover {
		background-color: var(--first-color-deep-alt, var(--first-color-alt));
		box-shadow: var(--shadow-md);
		transform: translateY(-1px);
	}
	.mail__send:active {
		transform: translateY(0);
	}

	@media (max-width: 520px) {
		.mail__row {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.4rem;
		}
		.mail__label {
			width: auto;
		}
		.mail__from {
			width: 100%;
		}
	}
</style>

---
import Sewing from '@assets/img/Sewing.webp';
import Pottery from '@assets/img/pottery.webp';
import Poetry from '@assets/img/sans-serifa.webp';
import HobbyCard from '@components/Hobby/HobbyCard.astro';
import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
---

<!--==================== HOBBIES ====================-->
<section class="services section" id="Services">
	<h2 class="section__title">
		👨🏼‍🎨
		{
			t({
				en: 'Hobbies',
				es: 'Pasatiempos',
				'pt-br': 'Passatempos',
			})
		}
	</h2>
	<div class="container layout-auto-grid">
		<HobbyCard
			title={t({
				en: 'Pottery',
				es: 'Cerámica',
				'pt-br': 'Cerâmica',
			})}
			image={Pottery}
			alt={t({ en: 'Pottery project', es: 'Proyecto de cerámica', 'pt-br': 'Projeto de cerâmica' })}
		/>

		<HobbyCard
			title={t({
				en: 'Sewing',
				es: 'Costura',
				'pt-br': 'Costura',
			})}
			image={Sewing}
			alt={t({ en: 'Sewing project', es: 'Proyecto de costura', 'pt-br': 'Projeto de costura' })}
		/>

		<HobbyCard
			title={t({
				en: 'Poetry',
				es: 'Poesía',
				'pt-br': 'Poesia',
			})}
			image={Poetry}
			alt={t({ en: 'Poetry project', es: 'Proyecto de poesía', 'pt-br': 'Projeto de poesia' })}
		/>
	</div>
</section>

<style>
	#Services {
		--layout-card-min: 15rem;
	}
</style>

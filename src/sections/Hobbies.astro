---
import Sewing from '@assets/img/Sewing.webp';
import Pottery from '@assets/img/pottery.webp';
import Poetry from '@assets/img/sans-serifa.webp';
import HobbyCard from '@components/Hobby/HobbyCard.astro';
import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
---

<!--==================== HOBBIES ====================-->
<section class="services section" id="Services">
	<h2 class="section__title">
		👨🏼‍🎨
		{
			t('hobbies.hobbies')
		}
	</h2>
	<div class="container layout-auto-grid">
		<HobbyCard
			title={t('hobbies.pottery')}
			image={Pottery}
			alt={t('hobbies.pottery-project')}
		/>

		<HobbyCard
			title={t('hobbies.sewing')}
			image={Sewing}
			alt={t('hobbies.sewing-project')}
		/>

		<HobbyCard
			title={t('hobbies.poetry')}
			image={Poetry}
			alt={t('hobbies.poetry-project')}
		/>
	</div>
</section>

<style>
	#Services {
		--layout-card-min: 15rem;
	}
</style>

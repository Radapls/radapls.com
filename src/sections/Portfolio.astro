---
import SpaceInvaders from '@assets/img/space-invaders.webp';
import Roulette from '@assets/img/roulette.webp';

import Cunctae from '@assets/img/c.svg';

import PortfolioCard from '@components/PortfolioCard.astro';
import SparkAr from '@assets/img/face-mesh.svg';

import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
const locale = Astro.currentLocale;
---

<section class="portfolio section" id="Portfolio" aria-labelledby="portfolio-title">
	<h2 class="section__title" id="portfolio-title">
		{
			t({
				en: 'Projects',
				es: 'Proyectos',
				'pt-br': 'Projetos',
			})
		}
	</h2>
	<div class="portfolio__container container">
		<div class="card-grid">
			<PortfolioCard
				variant="feature"
				bgImage={Roulette}
				title={t({
					en: 'Roulette Runner',
					es: 'Ruleta de corredores',
					'pt-br': 'Roleta de corrida',
				})}
				description={t({
					en: 'Win your next run distance!. Project in Monkey C for Garmin Devices',
					es: 'Gana tu proxima distancia de carrera!. Projecto es Monkey C para dispositivos Garmin',
					'pt-br':
						'Ganhe sua proxima distancia de carreira!. Projeto em Monkey C para dispositivos Garmin',
				})}
				link="https://github.com/Radapls/roulette"
			/>
			<PortfolioCard
				variant="side"
				bgImage={Cunctae}
				title={t({
					en: 'Cunctum UI',
					es: 'Cunctum UI',
					'pt-br': 'Cunctum UI',
				})}
				description={t({
					en: 'An Open Source Design system for Cunctae.com',
					es: 'Un sistema de diseño de código abierto para Cunctae.com',
					'pt-br': 'Um sistema de design de código aberto para Cunctae.com',
				})}
				link="https://cunctae.github.io/cunctum-ui/"
			/>
			<PortfolioCard
				variant="side"
				bgImage={SpaceInvaders}
				title={t({
					en: 'Space Invaders',
					es: 'Space Invaders',
					'pt-br': 'Space Invaders',
				})}
				description={t({
					en: 'Space Invaders project created with JavaScript and HTML Canvas',
					es: 'Proyecto Space Invaders creado con JavaScript y HTML Canvas',
					'pt-br': 'Projeto Space Invaders criado com JavaScript e HTML Canvas',
				})}
				link="https://radapls.github.io/space-invaders/"
			/>
			<PortfolioCard
				variant="wide"
				bgImage={SparkAr}
				title="Spark AR Filters"
				description={t({
					en: 'Instagram filters built with Spark AR',
					es: 'Filtros de Instagram construidos con Spark AR',
					'pt-br': 'Filtros do Instagram construídos com o Spark AR',
				})}
				link={`/${locale}/projects/spark-ar/`}
				external={false}
			/>
		</div>
	</div>
</section>

<style>
	.portfolio.section {
		height: 100vh;
		height: 100svh;
		min-height: 100svh;
		padding-block: clamp(1rem, 3svh, 2.25rem);
		--layout-gap: clamp(0.75rem, 1.5vw, 1.25rem);
	}
	@media screen and (min-width: 768px) {
		.portfolio.section {
			padding-top: calc(clamp(1rem, 3svh, 2.25rem) + var(--header-height) + 1.5rem);
		}
	}
	@media screen and (max-width: 767px) {
		.portfolio.section {
			padding-bottom: calc(clamp(0.75rem, 2svh, 1rem) + 5rem);
		}
	}
	.portfolio .section__title {
		flex: 0 0 auto;
		margin-bottom: clamp(0.75rem, 2.5svh, 1.75rem);
		font-size: clamp(1.5rem, 4svh, 2.25rem);
	}
	.portfolio__container {
		display: flex;
		flex: 1 1 auto;
		min-height: 0;
	}

	.card-grid {
		display: grid;
		flex: 1 1 auto;
		min-height: 0;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: repeat(3, minmax(0, 1fr));
		gap: var(--layout-gap);
		width: 100%;
	}

	@media screen and (max-width: 900px) {
		.card-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: repeat(3, minmax(0, 1fr));
		}
	}

	@media screen and (max-width: 560px), (max-height: 640px) {
		.portfolio.section {
			--layout-gap: clamp(0.5rem, 1.5svh, 0.75rem);
		}
		.portfolio .section__title {
			margin-bottom: clamp(0.5rem, 1.5svh, 0.75rem);
		}
		.card-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: repeat(2, minmax(0, 1fr));
		}
	}
	@media screen and (max-width: 560px) {
		.portfolio.section {
			padding-top: clamp(0.75rem, 2svh, 1rem);
		}
	}
	@media screen and (min-width: 768px) and (max-width: 900px) {
		.portfolio.section {
			padding-top: calc(clamp(0.75rem, 2svh, 1rem) + var(--header-height) + 1.5rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portfolio.section {
			height: auto;
			min-height: auto;
		}
		.card-grid {
			grid-template-rows: auto;
		}
	}
</style>

{
	"name": "portfolio",
	"compatibility_date": "2026-10-13",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "radapls.com", "custom_domain": true },
		{ "pattern": "blog.radapls.com", "custom_domain": true }
	],
	"previews": {}
}
